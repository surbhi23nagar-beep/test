     Everything below is that same app's card: 18px radius, hairline, sh-1.
     ====================================================================== */
  #p-provider .page-body{ padding:0 16px 28px; }
  .pp-hero{ --dc:var(--primary); --dcw:var(--primary-wash);
    position:relative; overflow:hidden; margin-top:13px; border-radius:22px;
