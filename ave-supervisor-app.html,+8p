  /* ---------- all actions ----------
     Everything the supervisor can do to this request, minus two that were in
     the way. "Material required" is not a decision made from a menu — it is
     something a technician reports from the flat, and it arrives on its own as
     a hold; the menu keeps only the way back out of one. "Escalate" left
     because it is a shift-level move rather than a per-request one, and it
     lives on the Alerts screen, next to the things worth escalating.

     Cancel is cut out of the list and drawn in red at the bottom: it is the
     only row here that cannot be undone, and as the tenth identical white row
     it was the easiest one to hit by mistake. */
  more:function(){
    var r = req(SH.id), rows = [], danger = null;
    if(isOpen(r)){
      if(isUnassigned(r)) rows.push(['assign','user','Assign Provider','']);
      else rows.push(['reassign','refresh','Reassign','Generates a new OTP']);
      if(r.flags.indexOf('duplicate')>=0) rows.push(['duplicate','copy','Review duplicate','Merge into '+r.dupOf]);
      rows.push(['otp','key','Manage OTP','Resend, regenerate or verify']);
      rows.push(['hold','cal','Reschedule','Move the visit to another slot']);
      rows.push(['category','edit','Change Service','Wrong category selected']);
      if(canResolve(r)) rows.push(['complete','checkC','Mark Complete','Close on behalf of the provider']);
      danger = ['cancel','xC','Cancel Request','Resident notified · provider released · OTP killed'];
    }else if(r.st==='completed' && r.pid){
      rows.push(['dispute','flag','Reopen the request','Resident says it is not done']);
