    return '<button class="sres" style="--acc:'+CATS[k].acc+';--accw:'+CATS[k].accw+'" data-gotocat="'+k+'">'
      + '<span class="sres-ic">'+svcIc(k,19)+'</span>'
      + '<span class="sres-tx"><b>'+hl(CATS[k].n,q)+'</b><span>'+n+' today · '+o+' still open</span></span>'
      + '<span style="color:var(--muted)">'+ic('chev',15)+'</span></button>'; }).join(''));
  if(provs.length) out += group('Providers', provs.length, provs.slice(0,4).map(function(p){
    return '<button class="sres" data-prov="'+p.id+'">'
      + '<span class="sres-ic" style="background:'+avc(p.n)+';color:#fff">'+initials(p.n)+'</span>'
      + '<span class="sres-tx"><b>'+hl(p.n,q)+'</b><span>'+p.skill+' · '+p.load+' active</span></span>'
      + '<span class="avlbl '+p.av+'">'+p.av+'</span></button>'; }).join(''));
  return out + '</div>';
}

