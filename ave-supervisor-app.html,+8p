  .quick{ display:flex; gap:8px; margin:0 18px; }
  .qbtn{ flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; padding:11px 4px; background:var(--surface); border:1px solid var(--line-2); border-radius:14px; font-size:10px; font-weight:700; color:var(--ink-2); cursor:pointer; box-shadow:var(--sh-1); transition:transform .13s var(--ease); }
  .qbtn:active{ transform:scale(.94); }
  .qbtn svg{ color:var(--primary-d); }
  .qbtn.dgr{ color:var(--coral); } .qbtn.dgr svg{ color:var(--coral); }

  /* ---- forms ---- */
  .f-lbl{ display:block; font-size:11.5px; font-weight:700; color:var(--ink-2); margin:14px 0 7px; }
  .f-lbl:first-child{ margin-top:0; }
  .f-input{ width:100%; border:1px solid var(--line-2); background:var(--surface); border-radius:12px; padding:12px 13px; font-family:inherit; font-size:13.5px; font-weight:500; color:var(--ink); outline:none; transition:border-color .15s, box-shadow .15s; }
  .f-input::placeholder{ color:var(--muted); }
  textarea.f-input{ resize:none; min-height:64px; line-height:1.45; }
  .f-input:focus{ border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-wash); }
  .opt-row{ display:flex; align-items:center; gap:11px; width:100%; padding:12px 13px; border-radius:14px; border:1.5px solid var(--line-2); background:var(--surface); cursor:pointer; text-align:left; transition:.15s; }
  .opt-row + .opt-row{ margin-top:8px; }
  .opt-row .oic{ width:34px; height:34px; border-radius:10px; display:grid; place-items:center; background:var(--accw,var(--surface-2)); color:var(--acc,var(--ink-2)); flex:none; }
  .opt-row .otx{ flex:1; min-width:0; } .opt-row .otx b{ display:block; font-size:13.5px; font-weight:700; } .opt-row .otx span{ display:block; font-size:11px; color:var(--muted); font-weight:500; margin-top:2px; line-height:1.35; }
  .opt-row .ock{ color:var(--primary); opacity:0; transform:scale(.6); transition:.15s var(--ease); flex:none; }
  .opt-row .ochv{ color:var(--muted); flex:none; display:flex; }
  .opt-row.on{ border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-wash); }
  .opt-row.on .ock{ opacity:1; transform:none; }
  /* the one row in the menu that cannot be taken back. Coral border, coral
     label, coral mark — read as a close/destructive control rather than as
     the tenth white row in a stack of white rows. */
  .opt-split{ height:1px; background:var(--line-2); margin:16px 2px 14px; }
  .opt-row.danger{ border-color:color-mix(in srgb, var(--coral) 55%, transparent);
    background:var(--surface); }
  .opt-row.danger:active{ background:var(--coral-wash); }
  .opt-row.danger .oic{ background:var(--coral-wash); color:var(--coral); }
  .opt-row.danger .otx b{ color:var(--coral); }
  .opt-row.danger .ochv{ color:var(--coral); }

  /* ---- sheets / scrim / toast ---- */
  .scrim{ position:absolute; inset:0; z-index:70; background:rgba(20,22,30,.42); opacity:0; pointer-events:none; transition:opacity .22s var(--ease); }
  .scrim.on{ opacity:1; pointer-events:auto; }
  .sheet{ position:absolute; left:0; right:0; bottom:0; z-index:80; background:var(--surface); border-radius:26px 26px 0 0; padding:8px 18px 24px; box-shadow:0 -10px 40px rgba(20,16,10,.22); transform:translateY(103%); transition:transform .3s var(--ease); max-height:90%; display:flex; flex-direction:column; }
  .sheet.on{ transform:translateY(0); }
  .sheet .grab{ width:40px; height:4px; border-radius:4px; background:var(--line-2); margin:0 auto 14px; flex:none; }
  .sheet h3{ font-size:17px; font-weight:800; letter-spacing:-.3px; text-align:center; flex:none; }
  .sheet .sub{ font-size:12.5px; color:var(--muted); text-align:center; margin-top:7px; line-height:1.5; padding:0 8px; flex:none; }
  .sheet-scroll{ overflow-y:auto; scrollbar-width:none; margin:14px -18px 0; padding:0 18px; }
  .sheet-scroll::-webkit-scrollbar{ display:none; }
  .sheet-btns{ display:flex; flex-direction:column; gap:9px; margin-top:16px; flex:none; }
  .sheet-ic{ width:52px; height:52px; border-radius:16px; display:grid; place-items:center; margin:2px auto 12px; background:var(--primary-wash); color:var(--primary-d); flex:none; }
  .sheet-ic.danger{ background:var(--coral-wash); color:var(--coral); }
  .sheet-ic.warn{ background:var(--amber-wash); color:var(--amber); }
  .sheet-ic.ok{ background:var(--green-wash); color:var(--green); }
  .toast{ position:absolute; left:16px; right:16px; bottom:96px; z-index:120; background:#1E2128; color:#fff; border-radius:14px; padding:13px 15px; display:flex; align-items:center; gap:11px; box-shadow:0 10px 30px rgba(0,0,0,.3); transform:translateY(180%); opacity:0; transition:transform .3s var(--ease), opacity .3s var(--ease); pointer-events:none; }
  .toast.on{ transform:translateY(0); opacity:1; pointer-events:auto; }
  .toast .tmsg{ flex:1; font-size:12.5px; font-weight:600; line-height:1.35; }

  /* ---- bottom nav — Wave Resident App duotone treatment, verbatim ---- */
  .ic-a{ fill:var(--ic-accent); }
  svg.ic{ color:var(--ic-stroke); display:block; }
  .nav .ni:not(.active){ --ic-stroke:#A0A4AD; --ic-accent:#A0A4AD; }  /* inactive tab: whole icon greys out */
  .navwrap{ position:absolute; left:0; right:0; bottom:0; z-index:55; padding:0 14px 14px; background:linear-gradient(to top, var(--bg) 58%, transparent); }
  .nav{ height:66px; background:rgba(255,255,255,.94); backdrop-filter:blur(14px) saturate(1.4); -webkit-backdrop-filter:blur(14px) saturate(1.4); border:1px solid var(--line-2); border-radius:18px; box-shadow:var(--sh-3); display:grid; grid-template-columns:repeat(4,1fr); align-items:center; padding:0 4px; }
  .ni{ display:flex; flex-direction:column; align-items:center; gap:4px; cursor:pointer; color:#A0A4AD; position:relative; padding-top:4px; background:none; border:none; }
  .ni span{ font-size:10px; font-weight:600; }
  .ni.active{ color:var(--primary-d); } .ni.active span{ font-weight:700; }
  .ni.active::before{ content:""; position:absolute; top:-1px; width:22px; height:3px; border-radius:3px; background:var(--primary); }
  .ni .nb{ position:absolute; top:0; right:calc(50% - 22px); min-width:16px; height:16px; padding:0 4px; border-radius:8px; background:var(--coral); color:#fff; font-size:9px; font-weight:800; display:grid; place-items:center; border:2px solid #fff; font-variant-numeric:tabular-nums; }

  /* ---- empty state ---- */
  .empty{ padding:44px 34px; text-align:center; }
  .empty .eic{ width:66px; height:66px; border-radius:21px; background:var(--surface); border:1px solid var(--line); display:grid; place-items:center; margin:0 auto 14px; color:var(--primary-d); box-shadow:var(--sh-1); }
  .empty b{ display:block; font-size:15px; font-weight:800; letter-spacing:-.2px; }
  .empty p{ font-size:12.5px; color:var(--muted); margin-top:7px; line-height:1.55; }

  /* ---- misc ---- */
  .note{ display:flex; gap:9px; align-items:flex-start; background:var(--amber-wash); border-radius:13px; padding:11px 12px; margin-top:12px; }
  .note svg{ color:var(--amber); flex:none; margin-top:1px; }
  .note p{ font-size:11.5px; color:#6D4A0E; font-weight:600; line-height:1.45; }
  .note.info{ background:var(--primary-wash); } .note.info svg{ color:var(--primary-d); } .note.info p{ color:var(--primary-d); }
  .note.dgr{ background:var(--coral-wash); } .note.dgr svg{ color:var(--coral); } .note.dgr p{ color:#8E2C20; }
  /* Alerts has no app bar, so the list needs its own air under the status bar
     — and a real element rather than a margin, which would collapse straight
     out of the absolutely-positioned .screen and give none. */
  .alert-top{ height:10px; }
  .grouplbl{ font-size:10px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:var(--muted); margin:20px 20px 10px; display:flex; align-items:center; gap:9px; }
  .grouplbl::after{ content:""; flex:1; height:1px; background:var(--line-2); }
  .ftr{ text-align:center; font-size:10.5px; color:var(--muted); font-weight:600; padding:24px 30px 6px; line-height:1.55; }
  /* ======================================================================
     PROVIDER PROFILE — the Wave Resident helper profile, field for field
     ======================================================================
     The resident app opens a maid's profile with a washed hero: photograph,
     name, trade pill, star row, and one green call button, with a soft disc
     bleeding off the top-right corner and the card's ground fading from the
     trade's own wash into white. Under it, two chips (phone, verified by the
