  .btn-primary{ color:#fff; background:var(--cta); box-shadow:var(--sh-cta); }
  .btn-danger{ color:#fff; background:var(--coral); box-shadow:0 3px 12px rgba(224,89,74,.32); }
  .btn-line{ color:var(--ink-2); background:var(--surface); border:1px solid var(--line-2); }
  .btn-wash{ color:var(--primary-d); background:var(--primary-wash); }
  .btn-sm{ padding:11px; font-size:13px; border-radius:12px; }
  .actbar{ display:grid; grid-template-columns:1fr 1fr; gap:9px; margin:0 18px; }
