  .pp-svcs{ display:flex; flex-wrap:wrap; gap:7px; margin-top:12px; }
  .pp-svc{ font-size:12px; font-weight:700; color:var(--ink-2); background:var(--surface-2);
    border-radius:999px; padding:7px 12px; }
  .pp-langs{ display:flex; align-items:center; gap:8px; margin-top:14px; padding-top:13px;
    border-top:1px solid var(--line); font-size:13px; font-weight:700; color:var(--ink-2); }
  .pp-langs svg{ color:var(--muted); flex:none; }

  /* the rating, broken down, with the flats' own words beside it */
  .pp-rtop{ display:flex; gap:18px; align-items:center; margin-top:14px; }
  .pp-rbig{ flex:none; text-align:center; }
  .pp-rbig b{ display:block; font-size:38px; font-weight:800; letter-spacing:-1.5px; line-height:.9;
    color:var(--ink); font-variant-numeric:tabular-nums; }
  .pp-rbig .pp-st{ margin-top:7px; }
  .pp-rc{ font-size:11px; color:var(--muted); font-weight:600; margin-top:6px; }
  .pp-dist{ flex:1; min-width:0; display:flex; flex-direction:column; gap:6px; }
  .pp-drow{ display:flex; align-items:center; gap:9px; font-size:10.5px; color:var(--muted); font-weight:700; }
  .pp-drow .n{ width:9px; text-align:right; flex:none; }
  .pp-drow .tr{ flex:1; height:6px; border-radius:99px; background:var(--surface-2); overflow:hidden; }
  .pp-drow .tr i{ display:block; height:100%; background:#E8A33D; border-radius:99px; }
  .pp-revs{ display:flex; gap:11px; overflow-x:auto; scrollbar-width:none; margin-top:15px; padding-bottom:2px; }
  .pp-revs::-webkit-scrollbar{ display:none; }
  .pp-rev{ flex:none; width:252px; border:1px solid var(--line); border-radius:16px; padding:14px;
    background:var(--surface); box-shadow:var(--sh-1); }
  .pp-rev .who{ display:flex; align-items:center; gap:10px; }
  .pp-rev .who .a{ width:36px; height:36px; flex:none; border-radius:50%; background:var(--primary-wash);
    color:var(--primary-d); display:grid; place-items:center; font-size:12px; font-weight:800; }
  .pp-rev .who b{ font-size:13px; font-weight:800; }
  .pp-rev .who span{ display:block; font-size:11px; color:var(--muted); font-weight:600; }
  .pp-rev .rt{ display:flex; align-items:center; justify-content:space-between; margin-top:12px; }

  .pp-rev .rt .wh{ font-size:10.5px; color:var(--muted); font-weight:600; }
  .pp-rev .tx{ font-size:12.5px; font-weight:600; color:var(--ink-2); margin-top:9px; line-height:1.5; }

  /* the board's own groups sit outside the card gutter the page now owns */
  #p-provider .grouplbl{ margin-left:2px; margin-right:2px; }
  #p-provider .list{ padding:0; }
  #p-provider .kpi{ margin:0; }

  /* ======================================================================
     SUPERVISOR PROFILE — the Wave Staff profile's construction
     ======================================================================
     A coloured header carrying the photograph and the two lines that say who
     is signed in, then facts, then the way out. The old screen opened on a
     white card with a 54px disc pushed into its left edge and a green "On
     shift" chip in the corner, which read as one more list row rather than as
     a person.
     ====================================================================== */
  .phead-flat{ box-shadow:none; padding-bottom:6px; }
  .prof-hero{ background:var(--ocean); color:#fff; text-align:center;
    padding:26px 22px 30px; border-radius:0 0 var(--r-xl) var(--r-xl); }
  .prof-av{ width:92px; height:92px; margin:0 auto 14px; border-radius:50%;
    background:rgba(255,255,255,.16); box-shadow:0 0 0 3px rgba(255,255,255,.3), var(--sh-3);
    display:grid; place-items:center; font-size:30px; font-weight:800; letter-spacing:-1px; color:#fff; }
  .prof-nm{ font-size:21px; font-weight:800; letter-spacing:-.5px; }
  .prof-role{ font-size:12.5px; font-weight:600; opacity:.82; margin-top:4px; }
  /* the stat strip rides the seam between the header and the page */
  .prof-stats{ margin-top:-18px; position:relative; z-index:2; padding:11px 12px; }

  /* a row that is a fact rather than a door: no chevron, no press state, and
     the value takes the weight the chevron used to */
  .srow-static{ cursor:default; }
  .srow .sval{ flex:none; font-size:13px; font-weight:700; color:var(--ink); font-variant-numeric:tabular-nums; }

  /* Sign out. A bordered coral button rather than a coral row on a coral
     wash — at the bottom of a page of white rows that read as one more
     disabled row, and this is the one control that ends the session. */
  .signout{ display:flex; align-items:center; gap:13px; width:100%; text-align:left;
    padding:14px 15px; background:var(--surface); border:1.5px solid var(--coral);
    border-radius:16px; cursor:pointer; transition:background .15s var(--ease), transform .14s var(--ease); }
  .signout:active{ background:var(--coral-wash); transform:scale(.99); }
  .signout-ic{ width:40px; height:40px; flex:none; border-radius:12px;
    background:var(--coral-wash); color:var(--coral); display:grid; place-items:center; }
  .signout-tx{ flex:1; min-width:0; }
  .signout-tx b{ display:block; font-size:14.5px; font-weight:800; color:var(--coral); }
  .signout-tx span{ display:block; font-size:11.5px; font-weight:600; color:var(--muted); margin-top:2px; }

  .srow{ display:flex; align-items:center; gap:12px; width:100%; text-align:left; padding:13px 0; background:none; border:none; cursor:pointer; }
  .srow + .srow{ border-top:1px solid var(--line); }
  .srow .sic{ width:36px; height:36px; border-radius:11px; background:var(--chip); color:var(--ink); display:grid; place-items:center; flex:none; }
  .srow .stx{ flex:1; min-width:0; } .srow .stx b{ display:block; font-size:13.5px; font-weight:700; } .srow .stx span{ display:block; font-size:11px; color:var(--muted); font-weight:500; margin-top:2px; }
  .srow .schv{ color:var(--muted); flex:none; }
  .barrow{ display:flex; align-items:center; gap:10px; padding:6px 0; }
  .barrow .bn{ font-size:11.5px; font-weight:700; color:var(--ink-2); width:86px; flex:none; }
  .barrow .bt{ flex:1; height:7px; border-radius:999px; background:var(--surface-2); overflow:hidden; }
  .barrow .bt i{ display:block; height:100%; border-radius:999px; background:var(--primary-2); }
  .barrow .bv{ font-size:11.5px; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; width:20px; text-align:right; flex:none; }

  /* ======================================================================
     HOME v2 — compact operational overview
     ====================================================================== */
  /* header: badge hangs off the corner so the bell stays fully readable */
  .icon-btn .dot{ top:-6px; right:-6px; }
  .avatar-btn{ background:var(--surface); color:var(--primary-d); border:1px solid var(--line-2);
    box-shadow:var(--sh-1); font-size:13.5px; letter-spacing:.02em; }
  /* breathing room from the system status bar, and an even rhythm down to the search field */
  .appbar{ padding-bottom:18px; }
  .topbar{ padding:18px 18px 16px; gap:14px; }
  .loc{ gap:5px; }
  .loc .hi{ font-size:12.5px; letter-spacing:.01em; }
  .loc .place{ font-size:17px; }
  .searchbar.live{ background:var(--surface); border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-wash); }
  .sb-cancel{ border:none; background:none; color:var(--primary-d); font-size:13px; font-weight:700; padding:0 2px 0 12px; cursor:pointer; flex:none; }
  .searchrow{ display:flex; align-items:center; margin:0 18px; }
  .searchrow .searchbar{ margin:0; flex:1; min-width:0; }

  /* ==== live board =========================================================
     A white card, the same one every other surface in the Wave apps is made
     of: --line hairline, --sh-2, 18px radius. It replaced a teal gradient
     slab with a decorative circle bleeding off the corner and 40px white
     figures on it — a shape that appears nowhere else in the resident or the
     staff app, and read as an illustration of a dashboard rather than as a
     dashboard.

     The count sits beside a teal glyph well, because a number alone with a
     caption under it is a statistic and a number in a row with a mark is a
     status. The four cells below each take their meaning's own colour on the
     app's plain grey ground: coral for nobody assigned, teal for moving,
     amber for late, red for escalated — so the row can be read across as the
     shape of the day rather than as four equal white-on-teal boxes.
     ========================================================================== */
  .hb{ margin:0 18px; background:var(--surface); border:1px solid var(--line);
    border-radius:18px; box-shadow:var(--sh-2); padding:15px 15px 13px; }
  .hb-top{ display:flex; align-items:center; gap:13px; }
  .hb-ic{ width:44px; height:44px; flex:none; border-radius:14px; display:grid; place-items:center;
    background:var(--primary-wash); color:var(--primary-d); }
  .hb-tx{ flex:1; min-width:0; display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
  .hb-tx b{ font-size:30px; font-weight:800; letter-spacing:-1.1px; line-height:1;
    font-variant-numeric:tabular-nums; color:var(--ink); }
  .hb-tx span{ font-size:12.5px; font-weight:600; color:var(--muted); }
  .hb-live{ flex:none; align-self:flex-start; display:inline-flex; align-items:center; gap:6px;
    font-size:10px; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
    color:var(--green); background:var(--green-wash); border-radius:999px; padding:4px 9px; }
  .hb-live i{ width:6px; height:6px; border-radius:50%; background:var(--green);
    box-shadow:0 0 0 3px color-mix(in srgb, var(--green) 20%, transparent); }
  /* four identical cells: same padding, same two-line structure, labels never wrap */
  .hb-row{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px;
    margin-top:15px; padding-top:14px; border-top:1px solid var(--line); }
  .hb-row button{ background:var(--surface-2); border:none; border-radius:13px; padding:10px 5px 9px;
    cursor:pointer; text-align:center; min-width:0;
    transition:background .16s var(--ease), transform .13s var(--ease); }
  .hb-row button:active{ transform:scale(.95); background:var(--chip); }
  .hb-row b{ display:block; font-size:20px; font-weight:800; line-height:1; letter-spacing:-.5px;
    font-variant-numeric:tabular-nums; color:var(--k, var(--ink)); }
  .hb-row em{ display:block; font-style:normal; font-size:9.5px; font-weight:700; color:var(--muted);
    margin-top:6px; letter-spacing:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  /* ---- compact result row: inline search results only ---- */
  .feed{ margin:0 18px; background:var(--surface); border:1px solid var(--line); border-radius:18px; box-shadow:var(--sh-2); overflow:hidden; }
  .fr{ display:flex; align-items:center; gap:12px; width:100%; text-align:left; background:none; border:none;
    padding:13px 14px; cursor:pointer; transition:background .15s var(--ease); }
  .fr + .fr{ border-top:1px solid var(--line); }
  .fr:active{ background:var(--surface-2); }
  .fr-ic{ width:34px; height:34px; border-radius:11px; display:grid; place-items:center; flex:none;
    background:var(--accw,var(--surface-2)); color:var(--acc,var(--ink-2)); }
  .fr-tx{ flex:1; min-width:0; }
  .fr-t{ font-size:13.5px; font-weight:700; letter-spacing:-.2px; line-height:1.25; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .fr-m{ display:flex; align-items:center; gap:7px; margin-top:6px; font-size:11px; font-weight:600; color:var(--muted); white-space:nowrap; overflow:hidden; }
  .fr-m i.d{ width:3px; height:3px; border-radius:50%; background:var(--line-2); flex:none; }
  .fr-m .where{ color:var(--ink-2); font-weight:700; font-variant-numeric:tabular-nums; }
  .fr-m .warn{ color:var(--ink-2); font-weight:600; }
  .fr-r{ flex:none; display:flex; align-items:center; gap:9px; }
  .fr-tag{ font-size:9.5px; font-weight:800; letter-spacing:.02em; border-radius:7px; padding:5px 8px;
    background:var(--accw,var(--coral-wash)); color:var(--acc,var(--coral)); white-space:nowrap; }
  .fr-ago{ font-size:10.5px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .fr-dot{ width:8px; height:8px; border-radius:50%; flex:none; }
  .feed-more{ display:flex; align-items:center; justify-content:center; gap:6px; width:100%; border:none;
    border-top:1px solid var(--line); background:var(--surface-2); color:var(--primary-d);
    font-size:12px; font-weight:700; padding:12px; cursor:pointer; }
  .feed-more:active{ background:var(--primary-wash); }
  .feed .empty{ padding:34px 26px; }

  /* ==== request card — the Wave Staff visitor card, for requests =============
     Anatomy taken from .vcard in the Staff app's design-system.css:477, which
     is itself the resident card's descendant. Two blocks stacked, never one
     column beside the mark:

       .rc-top   mark | (problem+state, flat+tower, raised by)
       .rc-band  the one line that varies — what is happening — | when

     The rule that does the work is the Staff app's: identity down the left,
     state down the right, at the same x on every card. A supervisor runs one
     column to find the escalated job instead of reading three lines of each.

     ---- Colour ---------------------------------------------------------------
     Red is spent only on Urgent and Escalated. Everything else that used to be
     coral — the re-opened badge, the note, the action — either steps down a
     tone or turns grey, because when six things on a card are red none of them
     is. The note follows .note in the Staff app: --muted text, no fill, no
     border, readable without competing with the state above it.

     ---- The mark -------------------------------------------------------------
     One blue well on every card, exactly as the resident app draws it
     (.sr-ic: --primary-wash behind --primary-d). It does NOT change colour per
     service: eight tinted wells made the list read as swatches, and the glyph
     already names the service. The glyph is chosen from the problem, so a
     broken tap gets a tap and an AC fault gets an AC.

     ---- Scale ----------------------------------------------------------------
     .rc-b is a stack of .rc-r rows. A fourth row costs one line and changes
     nothing else, and the band takes a second note without moving the rows
     above it.
     ========================================================================== */
  .rc{ display:block; width:100%; text-align:left; font-family:inherit; background:var(--surface);
    border:1px solid var(--line); border-radius:16px; box-shadow:var(--sh-1);
    padding:16px; margin-bottom:12px; cursor:pointer;
    transition:transform .13s var(--ease), box-shadow .13s var(--ease); }
  .rc:active{ transform:scale(.985); box-shadow:var(--sh-2); }

  .rc-top{ display:flex; align-items:flex-start; gap:12px; }
  .rc-ic{ width:44px; height:44px; border-radius:13px; display:grid; place-items:center; flex:none;
    background:var(--primary-wash); color:var(--primary-d); }
  .rc-b{ flex:1; min-width:0; }

  /* every row is identity-left, value-right, so the right column lines up */
  .rc-r{ display:flex; align-items:baseline; gap:10px; min-width:0; }
  .rc-r + .rc-r{ margin-top:5px; }

  .rc-t{ flex:0 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    font-size:14.5px; font-weight:800; letter-spacing:-.2px; line-height:1.25; color:var(--ink); }

  /* the flat is the fact checked against the door; the tower is context */
  .rc-where{ flex:1 1 auto; min-width:0; display:flex; align-items:center; gap:5px;
    font-size:12px; font-weight:500; color:var(--ink-2); line-height:1.35; }
  .rc-where svg{ width:13px; height:13px; flex:none; color:var(--muted); }
  .rc-where b{ flex:none; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; }
  .rc-where .sep{ flex:none; color:var(--muted); }

  .rc-by{ flex:1 1 auto; min-width:0; display:flex; align-items:center; gap:5px;
    font-size:11.5px; font-weight:500; color:var(--muted); line-height:1.35;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rc-by svg{ width:13px; height:13px; flex:none; color:var(--muted); }

  /* one pill per card, and red is reserved */
  .rc-st{ flex:none; margin-left:auto; display:inline-flex; align-items:center; gap:5px;
    padding:3px 8px; border-radius:7px; font-size:11px; font-weight:800; white-space:nowrap; }
  .rc-st.crit{ color:var(--red);       background:var(--red-wash); }
  .rc-st.warn{ color:var(--amber);     background:var(--amber-wash); }
  .rc-st.live{ color:var(--primary-d); background:var(--primary-wash); }
  .rc-st.ok  { color:var(--green);     background:var(--green-wash); }
  .rc-st.info{ color:var(--blue);      background:var(--blue-wash); }
  .rc-st.idle{ color:var(--muted);     background:var(--surface-2); }

  /* the band: what is happening, and when. The quietest text on the card. */
  .rc-band{ display:flex; align-items:center; gap:10px; margin-top:12px; padding-top:11px;
    border-top:1px solid var(--line); }
  .rc-note{ flex:1 1 auto; min-width:0; font-size:11.5px; font-weight:500; color:var(--muted);
    line-height:1.35; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rc-when{ flex:none; margin-left:auto; display:inline-flex; align-items:center; gap:5px;
    font-size:12px; font-weight:700; color:var(--ink-2); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .rc-when svg{ width:13px; height:13px; flex:none; color:var(--muted); }

  /* ==== the list card, stripped ============================================
     Four things, in the order they get asked: what is wrong, where, how long
     ago, and what has been done about it. Everything else the old card carried
     — request id, service name, who raised it, the assignee, the flag pills,
     the SLA bar, the note — moved to the detail screen, which is where a
     supervisor goes once they have decided this is the row they care about.
     The list is for choosing the row.

     No priority here. It is four numbers in the header instead, because a
     badge repeated down every card is a badge that has stopped sorting
     anything, and because the card should answer "what happened" rather than
     re-state "how much this matters".

     No assignee name either. "Assigned" is the fact the supervisor is scanning
     for; which of nine technicians it went to changes nothing until they open
     it, and a name plus a trade plus an avatar is three elements bought for
     one word of information.
     ========================================================================== */
  /* the tower is the part allowed to give way; the flat never truncates */
  .rc-where .tw{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rc-lite{ padding:14px 15px; }
  .rc-lite .rc-b{ padding-top:1px; }
  .rc-lite .rc-t{ display:block; white-space:normal; font-size:14.5px; line-height:1.3; }
  /* title left, status pinned top-right. flex-start rather than centre, so a
     two-line problem statement pushes the title down the card and leaves the
     pill exactly where it was on the card above. */
  .rc-lite .rc-head{ display:flex; align-items:flex-start; gap:10px; }
  .rc-lite .rc-head .rc-t{ flex:1 1 auto; min-width:0; }
  .rc-lite .rc-head .rc-st{ flex:none; margin-left:auto; margin-top:1px; }
  .rc-lite .rc-meta{ display:flex; align-items:center; margin-top:7px; }
  .rc-lite .rc-when{ margin-left:0; font-size:11.5px; font-weight:600; color:var(--muted); }
  .rc-lite .rc-where{ margin-top:6px; }

  /* Alerts: the reason, under a hairline. Only the glyph is tinted — the words
     stay ink so a column of eight reasons is readable rather than shouting,
     which is the mistake the old alert card made with its flag pills. */
  .rc-alert .rc-band{ margin-top:11px; padding-top:10px; }
  .rc-why{ flex:1 1 auto; min-width:0; display:flex; align-items:center; gap:7px;
    font-size:11.5px; font-weight:600; color:var(--ink-2); line-height:1.35; }
  .rc-why svg{ flex:none; color:var(--acc,var(--muted)); }
  .rc-why > span{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  /* ==== priority — the header's job, not the card's ==========================
     Three cells, always all three, so the shape of the day is one glance: the
     supervisor is reading the ratio, and a cell that disappears at zero would
     hide exactly the reassuring case. Tapping one filters to it, and tapping
     it again clears — the number and the filter are the same control, so
     there is nothing to reconcile.

     They used to be tinted red / blue / green, the same three washes the
     status pills inside the cards below are drawn from, which meant a red
     "High" tile and a red "Escalated" pill looked like the same kind of
     object. They are not: one is a control, the other is a fact about a
     request.

     So the resting state is neutral — grey ground, hairline stroke, the count
     in ink — and the selected state is Wave's teal: the wash behind it, the
     stroke and the type in the deep teal, with a soft teal ring so the chosen
     cell reads as chosen from across the screen. That is the same selected
     treatment the trade chips and the option rows already use, which is what
     makes it feel like the rest of the product rather than a widget of its
     own. Black did the job of standing out and nothing else; it belonged to
     no palette in either app.
     ========================================================================== */
  .prio-row{ display:grid; grid-auto-flow:column; grid-auto-columns:1fr; gap:8px; margin:14px 18px 0; }
  .pr{ border:1.5px solid var(--line-2); border-radius:14px; padding:11px 6px 10px;
    font-family:inherit; cursor:pointer; text-align:center; min-width:0;
    color:var(--muted); background:var(--surface-2);
    transition:transform .13s var(--ease), box-shadow .16s var(--ease),
               border-color .16s var(--ease), background .16s var(--ease); }
  .pr:active{ transform:scale(.96); }
  .pr b{ display:block; font-size:19px; font-weight:800; line-height:1; letter-spacing:-.5px;
    font-variant-numeric:tabular-nums; color:var(--ink); transition:color .16s var(--ease); }
  .pr em{ display:block; font-style:normal; font-size:10px; font-weight:700; margin-top:5px;
    color:var(--muted); letter-spacing:.01em; white-space:nowrap; overflow:hidden;
    text-overflow:ellipsis; transition:color .16s var(--ease); }
  .pr.on{ background:var(--primary-wash); border-color:var(--primary);
    box-shadow:0 0 0 3px color-mix(in srgb, var(--primary) 14%, transparent); }
  .pr.on b{ color:var(--primary-d); }
  .pr.on em{ color:var(--primary-d); font-weight:800; }

  /* the badge on the detail hero — the one screen that does spell priority out */
  .prio{ display:inline-flex; align-items:center; gap:4px; margin-left:8px; padding:2px 7px;
    border-radius:6px; font-size:9.5px; font-weight:800; letter-spacing:.03em;
    color:var(--red); background:var(--red-wash); }

  /* a filter button that says whether anything is hiding behind it */
  .icon-btn .fdot{ position:absolute; top:-3px; right:-3px; width:9px; height:9px; border-radius:50%;
    background:var(--primary); border:2px solid var(--bg); }

  /* ---- filter sheet ---- */
  .fsec + .fsec{ margin-top:18px; }
  .fsec-h{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:9px; }
  .fsec-h b{ font-size:11.5px; font-weight:700; color:var(--ink-2); }
  .fsec-h span{ font-size:11px; font-weight:600; color:var(--muted); }
  .fchips{ display:flex; flex-wrap:wrap; gap:7px; }
  .fchips .fchip{ font-size:12px; padding:7px 12px; }

  /* ==== status is a stage strip, not a chip row ==============================
     Status and service answer different questions — how far along, and what
     kind of work — so drawing both as the same pill made the header read as
     one long list of nineteen interchangeable filters. Service keeps the pills
     (.fchip). Status becomes an underlined tab strip: the shape every product
     uses for a pipeline, exclusive by construction, and one nothing else on
     this screen shares. Sitting on a hairline directly under the search field,
     it also reads as the spine of the list below it.
     ========================================================================== */
  .stabs{ display:flex; overflow-x:auto; scrollbar-width:none; padding:0 18px;
    margin-top:14px; box-shadow:inset 0 -1.5px 0 var(--line); }
  .stabs::-webkit-scrollbar{ display:none; }
  .stab{ flex:none; position:relative; display:inline-flex; align-items:center; gap:6px;
    border:none; background:none; font-family:inherit; cursor:pointer; white-space:nowrap;
    padding:9px 1px 11px; margin-right:19px; color:var(--muted);
    font-size:13px; font-weight:600; transition:color .15s var(--ease); }
  .stab:last-child{ margin-right:0; }
  .stab em{ font-style:normal; font-size:10.5px; font-weight:800; padding:2px 6px; border-radius:6px;
    background:var(--surface-2); color:var(--muted); font-variant-numeric:tabular-nums; }
  .stab.on{ color:var(--primary-d); font-weight:800; }
  .stab.on em{ background:var(--primary-wash); color:var(--primary-d); }
  .stab.on::after{ content:""; position:absolute; left:0; right:0; bottom:0; height:2.5px;
    border-radius:2px 2px 0 0; background:var(--primary); }

  /* Delayed and Escalated are not stages — a job can be In Progress and both
     at once — so they cannot sit in an exclusive row. They are one switch that
    display:inline-flex; align-items:center; justify-content:center;
    background:var(--line); color:var(--muted); font-variant-numeric:tabular-nums; }
  .seg button.on .n{ background:var(--primary); color:#fff; }
  .seg button.on .n.crit{ background:var(--red); }

  /* ---- inline home search ---- */
  .srch-lbl{ font-size:10px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:var(--muted); margin:0 20px 9px; }
  .srch-chips{ display:flex; flex-wrap:wrap; gap:8px; margin:0 18px; }
  .srch-chip{ display:inline-flex; align-items:center; gap:7px; padding:8px 13px; border-radius:999px; border:1px solid var(--line-2);
    background:var(--surface); font-size:12.5px; font-weight:600; color:var(--ink-2); cursor:pointer; }
  .srch-chip:active{ transform:scale(.96); }
  .srch-chip svg{ color:var(--muted); }
  .sres{ display:flex; align-items:center; gap:12px; width:100%; text-align:left; background:none; border:none; padding:11px 14px; cursor:pointer; }
  .sres + .sres{ border-top:1px solid var(--line); }
  .sres:active{ background:var(--surface-2); }
  .sres-ic{ width:34px; height:34px; border-radius:11px; display:grid; place-items:center; flex:none;
    background:var(--accw,var(--surface-2)); color:var(--acc,var(--ink-2)); font-size:11.5px; font-weight:800; }
  .sres-tx{ flex:1; min-width:0; }
  .sres-tx b{ display:block; font-size:13.5px; font-weight:700; letter-spacing:-.2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sres-tx span{ display:block; font-size:11px; font-weight:600; color:var(--muted); margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sres mark{ background:var(--primary-wash); color:var(--primary-d); border-radius:3px; padding:0 1px; }

  /* ======================================================================
     REQUEST DETAIL v2 — problem → where → status → assignee → OTP → activity
     ====================================================================== */
  #p-detail .page-body{ padding-bottom:110px; }
  .det-hero{ margin:20px 20px 0; }
  .det-eyebrow{ display:flex; align-items:center; gap:8px; font-size:10px; font-weight:800;
    letter-spacing:.09em; text-transform:uppercase; color:var(--muted); }
  .det-eyebrow .cd{ width:3px; height:3px; border-radius:50%; background:var(--line-2); }
  .det-title{ font-size:22px; font-weight:800; letter-spacing:-.6px; line-height:1.18; margin-top:9px; }
  .det-desc{ font-size:13px; color:var(--ink-2); line-height:1.6; margin-top:10px; }
  .det-desc.clip{ display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .det-more{ background:none; border:none; color:var(--primary-d); font-size:12px; font-weight:700; padding:6px 0 0; cursor:pointer; }
  /* section label sits outside the card — cheap hierarchy, lots of air */
  .det-lbl{ display:flex; align-items:center; justify-content:space-between; gap:10px;
    font-size:10px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:var(--muted); margin:26px 20px 10px; }
  .det-lbl button{ background:none; border:none; color:var(--primary-d); font-size:11px; font-weight:800;
    letter-spacing:.02em; text-transform:none; cursor:pointer; padding:0; }
  .det-blk{ margin:0 18px; background:var(--surface); border:1px solid var(--line); border-radius:18px;
    box-shadow:var(--sh-2); padding:15px 16px; }
  .det-rule{ height:1px; background:var(--line); margin:14px -16px; }

  /* The evidence. Framed, not floated: each tile is a filled thumbnail with a
     border of its own, inside a titled white block, so it cannot be mistaken
     for page decoration sitting on the background. */
  .det-ph{ display:flex; gap:10px; flex-wrap:wrap; }
  .det-pht{ position:relative; width:82px; height:82px; border-radius:12px; overflow:hidden;
    padding:0; border:1px solid var(--line-2); background:var(--surface-2); cursor:pointer;
    box-shadow:var(--sh-1); transition:transform .13s var(--ease); }
  .det-pht:active{ transform:scale(.95); }
  .det-pht img{ width:100%; height:100%; object-fit:cover; display:block; }
  .det-pht .ph-n{ position:absolute; right:5px; bottom:5px; min-width:16px; height:16px; padding:0 4px;
    border-radius:5px; background:rgba(20,22,30,.62); color:#fff; font-size:9.5px; font-weight:800;
    display:grid; place-items:center; }
  .det-phn{ font-size:11px; font-weight:600; color:var(--muted); margin-top:12px; }

  /* the resident app's .sq-grid: two columns of stacked label/value, for the
     facts you read rather than act on */
  .det-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px 14px; }
  .dkv{ min-width:0; }
  .dkl{ font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .dkvv{ font-size:14px; font-weight:700; color:var(--ink); margin-top:4px; line-height:1.3;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .dkvv.hot{ color:var(--coral); }
  .dkvv.muted{ color:var(--muted); font-weight:600; }
  .det-statusline{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .det-when{ font-size:11.5px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums; }

  /* the one inline action a person-row carries: a phone. There is no message
     twin — the supervisor's contact with a resident or a provider has to land
     on the request's own log, and a chat thread does not. */
  .dic{ width:42px; height:42px; flex:none; border-radius:13px; border:1px solid var(--line-2);
    background:var(--surface); color:var(--primary-d); display:grid; place-items:center;
    cursor:pointer; transition:transform .14s var(--ease), background .15s var(--ease); }
  .dic:active{ transform:scale(.93); background:var(--primary-wash); }

  /* assignee */
  .det-none{ display:flex; align-items:center; gap:12px; }
  .det-none .nic{ width:44px; height:44px; border-radius:50%; background:var(--surface-2); color:var(--muted);
    display:grid; place-items:center; flex:none; border:1.5px dashed var(--line-2); }
  .det-none .ntx b{ display:block; font-size:14px; font-weight:700; }
  .det-none .ntx span{ display:block; font-size:11.5px; font-weight:600; color:var(--muted); margin-top:3px; }

  /* OTP — one big, plain block with a single obvious action */
  .otp-plain{ text-align:center; }
  .otp-code{ display:flex; gap:7px; justify-content:center; }
  .otp-code i{ flex:1; max-width:50px; height:54px; border-radius:13px; background:var(--surface-2);
    display:grid; place-items:center; font-style:normal; font-size:23px; font-weight:800;
    font-variant-numeric:tabular-nums; color:var(--ink); border:1px solid var(--line); }
  .otp-plain.ok .otp-code i{ background:var(--green-wash); border-color:color-mix(in srgb, var(--green) 22%, transparent); color:var(--green); }
  .otp-plain.dead .otp-code i{ color:var(--muted); }
  .otp-state{ display:inline-flex; align-items:center; gap:7px; font-size:11.5px; font-weight:700;
    color:var(--muted); margin-top:12px; font-variant-numeric:tabular-nums; }
  .otp-state.ok{ color:var(--green); } .otp-state.warn{ color:var(--amber); } .otp-state.bad{ color:var(--coral); }
  .otp-apps{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:12px;
    font-size:10px; font-weight:700; color:var(--muted); }
  .otp-apps b{ font-weight:700; color:var(--ink-2); }

  /* activity */
  .det-tl{ margin-top:2px; }
  .tl-toggle{ display:flex; align-items:center; justify-content:center; gap:6px; width:100%; margin-top:13px;
    padding-top:13px; border-top:1px solid var(--line); background:none; border-left:none; border-right:none; border-bottom:none;
    color:var(--primary-d); font-size:12px; font-weight:700; cursor:pointer; }

  /* ======================================================================
     CHOOSE PROVIDER — the Wave Resident app's helper card, carrying our facts
     ======================================================================
     Same construction as the resident app's maid / cook / nanny rows: a round
     photograph, the name and the trade on one line, the flat facts under it,
     and then the small numbers on their own tinted bar so they never compete
     with the name. Our card adds the trade tags and a live availability dot,
     because the supervisor is choosing between people rather than confirming
     one they already expected.
     ====================================================================== */
  #p-pick .page-body{ padding-bottom:104px; }
  .pk-list{ padding:0 18px; }
  .pk{ display:block; width:100%; text-align:left; font-family:inherit; cursor:pointer;
    background:var(--surface); border:1px solid var(--line); border-radius:18px;
    box-shadow:var(--sh-2); padding:13px 14px; margin-bottom:11px;
    transition:transform .14s var(--ease), box-shadow .16s var(--ease), border-color .16s var(--ease); }
  .pk:active{ transform:scale(.985); box-shadow:var(--sh-1); }
  .pk.sel{ border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-wash), var(--sh-2); }
  .pk.busy{ opacity:.72; }
  .pk.busy.sel{ opacity:1; }

  .pk-top{ display:flex; align-items:flex-start; gap:13px; }
  .pk-av{ width:52px; height:52px; flex:none; border-radius:50%; display:grid; place-items:center;
    color:#fff; font-weight:800; font-size:16px; letter-spacing:-.4px; position:relative; }
  .pk-av i{ position:absolute; right:0; bottom:1px; width:14px; height:14px; border-radius:50%;
    border:2.5px solid var(--surface); }
  .pk-b{ flex:1; min-width:0; }
  .pk-nm{ display:flex; align-items:center; gap:8px; min-width:0; }
  .pk-nm b{ font-size:16px; font-weight:800; letter-spacing:-.3px; color:var(--ink);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pk-role{ flex:none; font-size:10px; font-weight:800; letter-spacing:.02em; padding:3px 9px;
    border-radius:999px; background:var(--primary-wash); color:var(--primary-d); white-space:nowrap; }
  .pk-sub{ display:flex; align-items:center; gap:6px; margin-top:5px;
    font-size:12.5px; font-weight:600; color:var(--ink-2); min-width:0; }
  .pk-sub svg{ width:12px; height:12px; flex:none; color:var(--muted); }
  .pk-dot{ width:3px; height:3px; border-radius:50%; background:var(--line-2); flex:none; }
  .pk-tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .pk-tag{ font-size:10px; font-weight:700; padding:3px 8px; border-radius:7px;
    background:var(--accw,var(--surface-2)); color:var(--acc,var(--ink-2)); }
  .pk-ck{ flex:none; color:var(--primary); opacity:0; transform:scale(.6);
    transition:.17s var(--ease); display:flex; margin-top:2px; }
  .pk.sel .pk-ck{ opacity:1; transform:none; }

  .pk-bar{ display:flex; align-items:center; gap:9px; margin-top:12px; padding:9px 11px;
    background:var(--surface-2); border-radius:12px; font-size:12px; font-weight:700; color:var(--ink-2); }
  .pk-seg{ display:inline-flex; align-items:center; gap:5px; min-width:0; }
  .pk-seg svg{ width:13px; height:13px; flex:none; color:var(--muted); }
  .pk-seg span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pk-sep{ width:3px; height:3px; border-radius:50%; background:var(--line-2); flex:none; }
  .pk-st{ margin-left:auto; flex:none; display:inline-flex; align-items:center; gap:6px;
    font-size:11px; font-weight:800; }
  .pk-st i{ width:6px; height:6px; border-radius:50%; background:currentColor; flex:none; }
  .pk-st--ok{ color:var(--green); }
  .pk-st--ok i{ box-shadow:0 0 0 3px var(--green-wash); }
  .pk-st--busy{ color:var(--amber); }

  /* sticky action bar — the next action is never scrolled away */
  .det-foot{ position:absolute; left:0; right:0; bottom:0; z-index:8; display:flex; align-items:center; gap:9px;
    padding:12px 16px 16px; background:rgba(255,255,255,.93);
    backdrop-filter:blur(14px) saturate(1.4); -webkit-backdrop-filter:blur(14px) saturate(1.4);
    border-top:1px solid var(--line-2); }
  .det-foot .btn{ flex:1; padding:14px 12px; font-size:14px; }
  .det-foot .fic{ width:50px; height:50px; flex:none; border-radius:14px; border:1px solid var(--line-2);
    background:var(--surface); color:var(--ink-2); display:grid; place-items:center; cursor:pointer;
    transition:transform .14s var(--ease); }
  .det-foot .fic:active{ transform:scale(.93); }

  /* ==========================================================================
     AUTH GATE — splash · login · OTP · onboarding
     Shown over the app on load, then faded away to reveal it.

     Every rule below is scoped under #authGate. That is not tidiness: the app
     already owns .otp-box / .otp-h / .otp-d / .otp-code for the SERVICE OTP a
     supervisor reads on a request (see the OTP blocks further up). Lifting the
     resident app's login CSS in verbatim would have silently restyled those.
     The login digit boxes are therefore .ao-box, and nothing here reaches
     outside the gate.
     ========================================================================== */
  #authGate{ position:absolute; inset:0; z-index:200; background:var(--bg);
    display:flex; flex-direction:column; overflow:hidden; transition:opacity .5s var(--ease); }
  #authGate.gone{ opacity:0; pointer-events:none; }
  #authGate .statusbar{ transition:color .35s var(--ease); }
  #authGate.on-dark .statusbar{ color:#fff; }

  .auth{ position:relative; flex:1; overflow:hidden; }
  /* Filmstrip. Screens carry exactly one of {nothing, .active, .past} at a
     time. Going forward the outgoing screen takes .past and recedes LEFT while
     the incoming one slides in from the right — same direction, so the two
     never cross and never leave a span neither covers, which is what showed as
     a seam when the outgoing screen animated back out to the right instead. */
  #authGate .au-screen{ position:absolute; inset:0; display:flex; flex-direction:column; background:var(--bg);
    transform:translateX(100%); transition:transform .44s var(--ease); will-change:transform; }
  #authGate .au-screen.active{ transform:translateX(0); }
  #authGate .au-screen.past{ transform:translateX(-26%); }
  #authGate .au-scroll{ flex:1; overflow-y:auto; scrollbar-width:none; }
  #authGate .au-scroll::-webkit-scrollbar{ display:none; }

  #authGate .au-btn{ width:100%; border:none; border-radius:16px; padding:17px; font-family:inherit;
    font-size:15.5px; font-weight:800; letter-spacing:-.2px; background:var(--cta); color:#fff;
    box-shadow:var(--sh-cta); cursor:pointer; margin-top:20px;
    display:inline-flex; align-items:center; justify-content:center; gap:9px;
    transition:transform .12s var(--ease), opacity .15s, box-shadow .2s; }
  #authGate .au-btn:active{ transform:scale(.985); }
  #authGate .au-btn:disabled{ opacity:.42; cursor:default; box-shadow:none; }
  #authGate .au-back{ width:40px; height:40px; border-radius:12px; background:var(--surface);
    border:1px solid var(--line-2); color:var(--ink); display:grid; place-items:center; cursor:pointer;
    box-shadow:var(--sh-1); }
  #authGate .au-back:active{ background:var(--surface-2); }

  /* ---- 1 · splash -------------------------------------------------------
     Ocean gradient rather than a photograph: this file has no image
     dependency beyond the Google font, and a prototype that opens correctly
     offline is worth more here than a stock hero. The sheet curves up over
     the panel's lower edge the way the Staff app's splash does. */
  /* The photograph the Resident app's welcome hero uses a photo for: a real
     tower elevation, not a drawn one. Embedded as a data URI (downscaled to
     760px, q72, ~118KB) so the app stays a single file that opens offline. */
  .sp-art{ position:relative; flex:1; min-height:0; overflow:hidden; background:#8FA3B4 center 22%/cover no-repeat url("data:image/jpeg;base64,"); }
  /* legibility scrim: the wordmark and badge sit on sky, which is bright */
  .sp-art::before{ content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(10,50,60,.46) 0%, rgba(10,50,60,.12) 34%, rgba(10,60,70,.06) 62%, rgba(9,58,68,.30) 100%); }
  .sp-mark{ position:relative; z-index:2; display:inline-flex; align-items:center; gap:11px; margin:46px 0 0 26px; }
  .sp-logo{ width:38px; height:38px; border-radius:12px; background:rgba(255,255,255,.17);
    border:1px solid rgba(255,255,255,.28); display:grid; place-items:center; flex:none;
    -webkit-backdrop-filter:blur(5px); backdrop-filter:blur(5px); }
  .sp-mark b{ font-size:18px; font-weight:800; letter-spacing:-.3px; color:#fff; }
  .sp-mark b span{ color:rgba(255,255,255,.68); font-weight:700; }
  .sp-badge{ position:relative; z-index:2; display:inline-flex; align-items:center; gap:7px;
    margin:16px 0 0 26px; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.26);
    color:#fff; font-size:10.5px; font-weight:800; letter-spacing:.07em; text-transform:uppercase;
    padding:6px 12px; border-radius:999px; -webkit-backdrop-filter:blur(5px); backdrop-filter:blur(5px); }
  /* faint tower silhouettes — the sector this supervisor actually walks */
  .sp-sheet{ position:relative; z-index:3; flex:none; margin-top:-30px; background:var(--bg);
    border-radius:30px 30px 0 0; padding:30px 26px 26px; box-shadow:0 -14px 34px rgba(10,40,46,.16); }
  .sp-h1{ font-size:27px; font-weight:800; letter-spacing:-.7px; line-height:1.14; }
  .sp-h1 span{ color:var(--primary-d); }
  .sp-tag{ font-size:13.5px; font-weight:500; color:var(--ink-2); line-height:1.55; margin-top:10px; }
  .sp-note{ text-align:center; font-size:11.5px; font-weight:600; color:var(--muted); margin-top:15px; }

  /* ---- 2 · login -------------------------------------------------------- */
  .w-band{ flex:none; padding:12px 20px 0; }
  .w-body{ padding:6px 24px 26px; }
  .w-h1{ font-size:27px; font-weight:800; letter-spacing:-.7px; line-height:1.14; margin-top:20px; }
  .w-h1 span{ color:var(--primary-d); }
  .w-sub{ font-size:13.5px; font-weight:500; color:var(--ink-2); line-height:1.55; margin-top:9px; }
  .w-flbl{ display:block; font-size:12px; font-weight:700; color:var(--ink-2); margin:24px 2px 8px; }
  .w-phone{ display:flex; gap:9px; }
  .w-cc{ display:inline-flex; align-items:center; gap:7px; flex:none; border:1.5px solid var(--line-2);
    background:var(--surface); border-radius:14px; padding:0 14px; font-size:15px; font-weight:800; color:var(--ink); }
  .w-cc .flag{ width:20px; height:14px; border-radius:3px; overflow:hidden; display:block; box-shadow:0 0 0 1px rgba(0,0,0,.06); }
  .w-input{ flex:1; min-width:0; width:100%; border:1.5px solid var(--line-2); background:var(--surface);
    border-radius:14px; padding:15px 16px; font-family:inherit; font-size:16px; font-weight:700;
    letter-spacing:.5px; color:var(--ink); outline:none; transition:border-color .15s, box-shadow .15s; }
  .w-input::placeholder{ color:var(--muted); font-weight:600; letter-spacing:0; }
  .w-phone:focus-within .w-input{ border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-wash); }
  .w-terms{ display:flex; align-items:flex-start; gap:11px; margin-top:22px; cursor:pointer; -webkit-tap-highlight-color:transparent; }
  .w-check{ width:22px; height:22px; border-radius:7px; border:1.9px solid var(--line-2); background:var(--surface);
    flex:none; display:grid; place-items:center; transition:.16s; margin-top:1px; }
  .w-check svg{ opacity:0; transform:scale(.5); transition:.16s; }
  .w-terms.on .w-check{ background:var(--primary); border-color:var(--primary); }
  .w-terms.on .w-check svg{ opacity:1; transform:scale(1); }
  .w-terms p{ font-size:12.5px; font-weight:500; color:var(--ink-2); line-height:1.5; }
  .w-terms a{ color:var(--primary-d); font-weight:800; text-decoration:none; }
  .w-note{ display:flex; align-items:flex-start; gap:9px; margin-top:18px; padding:11px 13px;
    border-radius:13px; background:var(--surface-2); border:1px solid var(--line); }
  .w-note > svg{ flex:none; color:var(--muted); margin-top:1px; }
  .w-note p{ font-size:11.5px; font-weight:600; color:var(--muted); line-height:1.5; }

  /* ---- 3 · OTP ----------------------------------------------------------
     The whole screen sits in .au-scroll: with the error line showing, hero
     plus card can outgrow a short viewport, and .auth clips overflow rather
     than scrolling it — content would be cut off, not just squeezed. */
  .o-hero{ flex:none; position:relative; text-align:center; padding:12px 24px 50px;
    background:linear-gradient(180deg, var(--bg-top) 0%, var(--bg) 100%); }
  .o-hero .au-back{ position:absolute; left:20px; top:12px; z-index:2; }
  .o-badge{ width:70px; height:70px; margin:26px auto 0; border-radius:22px; background:var(--surface);
    border:1px solid var(--line); color:var(--primary-d); display:grid; place-items:center; box-shadow:var(--sh-2); }
  .o-h1{ font-size:23px; font-weight:800; letter-spacing:-.4px; margin-top:18px; color:var(--ink); }
  .o-hsub{ font-size:13px; font-weight:500; color:var(--muted); line-height:1.55; margin-top:8px; }
  .o-hsub b{ color:var(--ink); font-weight:800; }
  .o-chg{ display:inline-flex; align-items:center; gap:6px; margin-top:15px; background:var(--surface);
    border:1px solid var(--line-2); color:var(--ink-2); font-family:inherit; font-size:12px; font-weight:800;
    padding:8px 15px; border-radius:999px; cursor:pointer; box-shadow:var(--sh-1); }
  .o-chg:active{ background:var(--surface-2); }
  .o-card{ position:relative; z-index:2; margin:-30px 20px 0; background:var(--surface); border-radius:24px;
    box-shadow:0 16px 36px -16px rgba(20,22,30,.16), var(--sh-1); padding:24px 20px 22px; }
  .o-clbl{ text-align:center; font-size:12px; font-weight:800; color:var(--ink-2); }
  .ao-row{ display:flex; gap:9px; margin-top:16px; }
  .ao-box{ flex:1; min-width:0; height:60px; border:1.25px solid var(--line-2); background:var(--surface);
    border-radius:15px; text-align:center; font-family:inherit; font-size:24px; font-weight:800; color:var(--ink);
    outline:none; font-variant-numeric:tabular-nums; padding:0;
    transition:border-color .15s, box-shadow .15s, background .15s, color .15s, transform .12s; }
  .ao-box.filled{ border-color:var(--ink-2); }
  .ao-box:focus{ border-color:var(--ink); box-shadow:0 0 0 3px rgba(27,29,36,.09); transform:translateY(-1px); }
  .ao-box.ok{ border-color:var(--green); background:var(--green-wash); color:var(--green); box-shadow:none; }
  .ao-box.err{ border-color:var(--coral); background:var(--coral-wash); color:var(--coral); box-shadow:none;
    animation:aoShake .38s var(--ease); }
  @keyframes aoShake{ 0%,100%{ transform:translateX(0);} 22%{ transform:translateX(-5px);} 44%{ transform:translateX(5px);}
    66%{ transform:translateX(-3px);} 88%{ transform:translateX(3px);} }
  .o-error{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:14px;
    font-size:12px; font-weight:700; color:var(--coral); }
  .o-error[hidden]{ display:none; }
  .o-demo{ display:flex; align-items:center; justify-content:center; gap:7px; margin:16px auto 0; width:max-content;
    font-size:11px; font-weight:700; color:var(--ink-2); background:var(--surface-2); border-radius:999px; padding:7px 13px; }
  .o-resend{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:18px;
    font-size:12.5px; font-weight:600; color:var(--muted); }
  .o-resend button{ background:none; border:none; font-family:inherit; font-size:12.5px; font-weight:800;
    color:var(--ink); cursor:pointer; padding:0; text-decoration:underline; text-underline-offset:2px; }
  .o-resend button:disabled{ color:var(--muted); cursor:default; opacity:.85; text-decoration:none; }
  .o-help{ text-align:center; font-size:12px; font-weight:500; color:var(--muted); margin:18px 0 24px; }
  .o-help a{ color:var(--ink); font-weight:800; text-decoration:underline; text-underline-offset:2px; }

  /* verified dialog */
  .au-scrim{ position:absolute; inset:0; background:rgba(16,26,28,.5); -webkit-backdrop-filter:blur(2px);
    backdrop-filter:blur(2px); opacity:0; pointer-events:none; transition:opacity .25s; z-index:70; }
  .au-scrim.on{ opacity:1; pointer-events:auto; }
  .au-dlg{ position:absolute; left:22px; right:22px; top:50%; transform:translateY(-50%) scale(.92); opacity:0;
    pointer-events:none; background:var(--surface); border-radius:26px; padding:30px 24px 24px; text-align:center;
    box-shadow:0 24px 60px rgba(10,40,46,.34); z-index:80;
    transition:opacity .28s var(--ease), transform .28s var(--ease); }
  .au-dlg.on{ opacity:1; pointer-events:auto; transform:translateY(-50%) scale(1); }
  .dlg-ic{ width:82px; height:82px; border-radius:50%; margin:0 auto; display:grid; place-items:center;
    background:var(--green-wash); position:relative; color:var(--green); }
  .dlg-ic::before{ content:""; position:absolute; inset:-9px; border-radius:50%; border:2px solid var(--green-wash); }
  .dlg-ic .rg{ position:absolute; inset:-9px; border-radius:50%; border:2px solid var(--green); opacity:.32;
    animation:dlgpulse 1.8s var(--ease) infinite; }
  @keyframes dlgpulse{ 0%{ transform:scale(.9); opacity:.5; } 100%{ transform:scale(1.35); opacity:0; } }
  .au-dlg h3{ font-size:21px; font-weight:800; letter-spacing:-.3px; margin-top:20px; }
  .au-dlg p{ font-size:13.5px; font-weight:500; color:var(--ink-2); line-height:1.55; margin-top:9px; }
  .au-dlg p b{ color:var(--ink); font-weight:800; }

  @media (prefers-reduced-motion: reduce){
    #authGate, #authGate *{ animation-duration:.001ms !important; animation-iteration-count:1 !important;
      transition-duration:.001ms !important; }
  }

  /* ==========================================================================
     REQUEST DETAIL — the Wave Resident app's hierarchy, verbatim

     The resident and the supervisor are looking at the same request, so they
     should read it in the same order. Lifted from the resident app's service
     detail screen (its .sd-* / .sq-* / .tl-* blocks) and re-pointed at this
     app's tokens, which carry the same names.

     One rename: the resident's key/value pair is .kv/.kl/.kvv, and this app
     already owns .kv for the sheet list rows (kvList(), the OTP block, the
     old detail grid). Imported as .sq-kv/.sq-kl/.sq-kvv so the two cannot
     collide — same pixels, different name.
     ========================================================================== */
  .sd-banner{ text-align:center; padding:22px 16px 20px; border-radius:20px; border:1px solid var(--line); }
  .sd-banner.wait{ background:radial-gradient(135% 80% at 50% -10%, var(--primary-wash), var(--surface) 62%); }
  .sd-banner.prog{ background:radial-gradient(135% 80% at 50% -10%, var(--amber-wash), var(--surface) 60%); }
  .sd-banner.done{ background:radial-gradient(135% 80% at 50% -10%, var(--green-wash), var(--surface) 60%); }
  .sd-banner.cx{   background:radial-gradient(135% 80% at 50% -10%, var(--coral-wash), var(--surface) 60%); }
  .sd-banner h2{ font-size:20px; font-weight:800; letter-spacing:-.3px; margin-top:13px; line-height:1.25; }
  .sd-banner p{ font-size:12.5px; color:var(--muted); margin-top:6px; font-weight:500; line-height:1.5; max-width:280px; margin-left:auto; margin-right:auto; }
  .sd-tk{ font-size:11px; font-weight:700; color:var(--muted); margin-top:12px; letter-spacing:.02em; font-variant-numeric:tabular-nums; }

  .sd-c{ background:var(--surface); border:1px solid var(--line); border-radius:18px; box-shadow:var(--sh-1); padding:16px; margin-top:13px; }
  .sd-h{ font-size:11.5px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:var(--muted); margin-bottom:14px;
    display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .sd-h button{ border:none; background:none; font-family:inherit; font-size:11.5px; font-weight:800; letter-spacing:0;
    text-transform:none; color:var(--primary-d); cursor:pointer; padding:0; }

  /* progress — the vertical filmstrip the resident sees, not a horizontal stepper */
  .tl-step{ display:flex; gap:13px; position:relative; padding-bottom:20px; } .tl-step:last-child{ padding-bottom:0; }
  .tl-step .tl-mk{ width:26px; height:26px; border-radius:50%; flex:none; display:grid; place-items:center; z-index:1;
    background:var(--surface-2); color:var(--muted); border:2px solid var(--line-2); }
  .tl-step.done .tl-mk{ background:var(--green); border-color:var(--green); color:#fff; }
  .tl-step.cur .tl-mk{ background:var(--primary); border-color:var(--primary); color:#fff; box-shadow:0 0 0 4px var(--primary-wash); }
  .tl-step::before{ content:""; position:absolute; left:12px; top:26px; bottom:0; width:2px; background:var(--line-2); }
  .tl-step:last-child::before{ display:none; } .tl-step.done::before{ background:var(--green); }
  .tl-tx b{ font-size:13.5px; font-weight:700; color:var(--ink); display:block; }
  .tl-step.pend .tl-tx b{ color:var(--muted); font-weight:600; }
  .tl-tx span{ font-size:11.5px; color:var(--muted); font-weight:500; margin-top:3px; display:block; font-variant-numeric:tabular-nums; }

  .sd-row{ display:flex; gap:12px; padding:11px 0; } .sd-row:first-child{ padding-top:0; }
  .sd-row + .sd-row{ border-top:1px solid var(--line); }
  .sd-row .k{ font-size:12.5px; color:var(--muted); font-weight:600; width:104px; flex:none; }
  .sd-row .v{ font-size:12.5px; color:var(--ink); font-weight:600; flex:1; line-height:1.45; }

  /* assigned professional */
  .sd-tech{ display:flex; align-items:center; gap:13px; }
  .sd-tech .av{ position:relative; width:48px; height:48px; border-radius:14px; color:#fff; display:grid; place-items:center;
    font-size:16px; font-weight:800; flex:none; }
  .sd-tech .av i{ position:absolute; right:-2px; bottom:-2px; width:13px; height:13px; border-radius:50%; border:2.5px solid var(--surface); }
  .sd-tech .av i.av-available{ background:var(--green); } .sd-tech .av i.av-busy{ background:var(--amber); }
  .sd-tech .av i.av-off{ background:var(--muted); }
  .sd-tech .tm{ flex:1; min-width:0; } .sd-tech .tm b{ font-size:14.5px; font-weight:800; letter-spacing:-.2px; }
  .sd-tech .tm span{ display:block; font-size:11.5px; color:var(--muted); font-weight:600; margin-top:2px; }
  .sd-tech .trate{ font-size:12px; font-weight:800; color:var(--amber); display:inline-flex; align-items:center; gap:3px; flex:none; }
  .sd-tcta{ display:flex; gap:10px; margin-top:14px; }
  .sd-tcta button{ flex:1; border:1px solid var(--line-2); background:var(--surface); border-radius:12px; padding:11px;
    font-family:inherit; font-size:13px; font-weight:800; color:var(--primary-d); cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; gap:7px; transition:background .15s; }
  .sd-tcta button:active{ background:var(--surface-2); }
  .sd-tcta button.pri{ background:var(--primary-wash); border-color:transparent; }
  .sd-await{ display:flex; align-items:center; gap:11px; color:var(--muted); }
  .sd-await .aw-ic{ width:44px; height:44px; border-radius:13px; background:var(--surface-2); display:grid; place-items:center; flex:none; }
  .sd-await b{ font-size:13.5px; color:var(--ink-2); font-weight:800; display:block; }
  .sd-await span{ font-size:11.5px; font-weight:500; display:block; margin-top:2px; line-height:1.45; }

  /* photos */
  .sd-ph{ display:flex; gap:9px; flex-wrap:wrap; }
  .sd-ph .pt{ position:relative; width:78px; height:78px; border-radius:12px; overflow:hidden; border:1px solid var(--line);
    background:var(--surface-2); padding:0; cursor:pointer; }
  .sd-ph .pt img{ width:100%; height:100%; object-fit:cover; display:block; }
  .sd-ph .pt .ph-n{ position:absolute; right:5px; bottom:5px; min-width:17px; height:17px; border-radius:5px;
    background:rgba(20,22,30,.62); color:#fff; font-size:10px; font-weight:800; display:grid; place-items:center; padding:0 4px; }
  .sd-phn{ font-size:11.5px; color:var(--muted); font-weight:500; margin-top:10px; line-height:1.45; }

  /* request info — the resident's scannable block, in its order */
  .sq-head{ display:flex; align-items:center; gap:12px; }
  .sq-av{ width:44px; height:44px; border-radius:12px; color:#fff; display:grid; place-items:center; font-size:14px; font-weight:800; flex:none; }
  .sq-hm{ flex:1; min-width:0; }
  .sq-hm .rb{ font-size:10px; color:var(--muted); font-weight:800; text-transform:uppercase; letter-spacing:.06em; }
  .sq-hm b{ display:block; font-size:15.5px; font-weight:800; letter-spacing:-.2px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .sq-meta{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-size:11.5px; color:var(--muted); font-weight:600;
    margin-top:12px; padding-top:12px; border-top:1px solid var(--line); font-variant-numeric:tabular-nums; }
  .sq-meta .tk{ color:var(--primary-d); font-weight:800; }
  .sq-meta .dt{ width:3px; height:3px; border-radius:50%; background:var(--line-2); }
  .sq-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px 14px; margin-top:16px; }
  .sq-kv{ min-width:0; }
  .sq-kv .sq-kl{ font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .sq-kv .sq-kvv{ font-size:14px; font-weight:700; color:var(--ink); margin-top:4px; line-height:1.3; overflow:hidden; text-overflow:ellipsis; }
  .sq-kv .sq-kvv.teal{ color:var(--primary-d); } .sq-kv .sq-kvv.mono{ letter-spacing:2px; font-variant-numeric:tabular-nums; }
  .sq-kv .sq-kvv.muted{ color:var(--muted); } .sq-kv .sq-kvv.hot{ color:var(--coral); }
  .sq-reason{ margin-top:17px; padding-top:15px; border-top:1px solid var(--line); }
  .sq-reason .sq-kl{ font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .sq-reason p{ font-size:13.5px; color:var(--ink-2); line-height:1.6; margin-top:7px; font-weight:500; }
  .sq-reason p b{ color:var(--ink); font-weight:800; }
  .sq-assign{ display:flex; align-items:center; gap:11px; margin-top:15px; padding-top:15px; border-top:1px solid var(--line); }
  .sq-assign .aa{ width:38px; height:38px; border-radius:11px; background:var(--surface-2); color:var(--muted); display:grid; place-items:center; flex:none; }
  .sq-assign.on .aa{ background:var(--green-wash); color:var(--green); }
  .sq-assign .am{ flex:1; min-width:0; }
  .sq-assign .al{ font-size:10px; color:var(--muted); font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
  .sq-assign .av2{ font-size:14px; font-weight:800; margin-top:2px; } .sq-assign .av2.muted{ color:var(--muted); }
  .sq-callmini{ flex:none; width:38px; height:38px; border-radius:11px; border:1px solid var(--line-2); background:var(--surface);
    color:var(--green); display:grid; place-items:center; cursor:pointer; } .sq-callmini:active{ background:var(--green-wash); }

  /* ==========================================================================
     PROVIDER CARD — the Wave Resident app's Daily Helpers card, verbatim

     Same geometry as the Maid / Cook / Gardener rows: a 60px round avatar, the
     name at 17/800, a rating line carrying a coloured role chip, five stars and
     a review count, a small meta line under it, and a three-up action bar
     divided by hairlines across the foot of the card.

     One substitution. The resident's .dh-av is a photograph; this app ships no
     external images at all (even the request photos are inline SVG data URIs,
     so it opens correctly offline) and there are no provider portraits to
     ship. The avatar keeps the resident's exact circle — 60px, round, same
     slot, same gap — and fills it with the initials mark this app already uses
     everywhere else, plus the availability dot the supervisor needs and the
     resident's card has no equivalent of.
     ========================================================================== */
  .dh-card{ background:var(--surface); border:1px solid var(--line); border-radius:16px; box-shadow:var(--sh-2);
    margin-bottom:12px; overflow:hidden; animation:fade .3s var(--ease) both; }
  .dh-card[role="button"]{ cursor:pointer; transition:transform .14s var(--ease), box-shadow .18s; }
  .dh-card[role="button"]:active{ transform:scale(.992); box-shadow:var(--sh-1); }
  .dh-top{ display:flex; align-items:center; gap:13px; padding:13px 14px; }
  .dh-av{ position:relative; width:60px; height:60px; border-radius:50%; flex:none; display:grid; place-items:center;
    color:#fff; font-size:19px; font-weight:800; letter-spacing:-.3px; background:var(--surface-2); }
  .dh-av i{ position:absolute; right:1px; bottom:1px; width:15px; height:15px; border-radius:50%; border:2.5px solid var(--surface); }
  .dh-av i.av-available{ background:var(--green); } .dh-av i.av-busy{ background:var(--amber); }
  .dh-av i.av-off{ background:var(--muted); }
  .dh-mid{ flex:1; min-width:0; }
  .dh-nm{ font-size:17px; font-weight:800; letter-spacing:-.3px; display:flex; align-items:center; gap:6px; }
  .dh-nm .vf{ color:var(--primary); display:inline-flex; flex:none; }
  .dh-rate{ display:flex; align-items:center; gap:7px; margin-top:6px; flex-wrap:wrap; }
  .dh-role{ font-size:10px; font-weight:800; letter-spacing:.02em; padding:3px 9px; border-radius:6px;
    background:var(--dc,var(--primary)); color:#fff; flex:none; }
  .dh-stars{ display:inline-flex; gap:1px; }
  .dh-stars svg{ display:block; }
  .dh-cnt{ font-size:12px; color:var(--muted); font-weight:600; }
  .dh-apt{ display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--ink-2); font-weight:500; margin-top:8px; }
  .dh-apt svg{ flex:none; color:var(--muted); } .dh-apt b{ color:var(--primary-d); font-weight:700; }
  .dh-apt .sep{ width:3px; height:3px; border-radius:50%; background:var(--line-2); flex:none; }
  .dh-actbar{ display:flex; border-top:1px solid var(--line); }
  .dh-act{ flex:1; display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:13px 4px; border:none;
    background:transparent; font-family:inherit; font-size:12.5px; font-weight:700; color:var(--primary-d); cursor:pointer;
    transition:background .15s; }
  .dh-act:active{ background:var(--surface-2); }
  .dh-act + .dh-act{ border-left:1px solid var(--line); } .dh-act svg{ flex:none; }
  .dh-empty{ text-align:center; color:var(--muted); font-size:13px; font-weight:500; padding:40px 20px; }

  /* selected state, for the assign list */
  .dh-card.sel{ border-color:var(--primary); box-shadow:0 0 0 2px var(--primary-wash), var(--sh-2); }

  /* ==========================================================================
     ASSIGNMENT CONFIRMATION — the one moment worth animating

     Assigning is the supervisor's most consequential act and the only one with
     no undo, so it gets a beat of feedback rather than a toast that slides past
     while they are already tapping back. Three short steps, ~950ms end to end:
     the avatar becomes a drawn tick, a line of text arrives under it, and the
     request screen behind updates with the provider now on it.

     Deliberately restrained — no bounce, no confetti, no scale-overshoot. A
     supervisor does this thirty times a shift.
     ========================================================================== */
  .pp-av{ transition:background .32s var(--ease); }
  .pp-av .ini{ transition:opacity .18s var(--ease), transform .28s var(--ease); }
  .pp-av .tick{ position:absolute; inset:0; display:grid; place-items:center; opacity:0; transition:opacity .16s var(--ease) .1s; }
  .pp-av .tick path{ stroke-dasharray:30; stroke-dashoffset:30; }
  .pp-av.assigned{ background:var(--green) !important; }
  .pp-av.assigned .ini{ opacity:0; transform:scale(.6); }
  .pp-av.assigned .tick{ opacity:1; }
  .pp-av.assigned .tick path{ animation:tickDraw .42s var(--ease) .12s forwards; }
  @keyframes tickDraw{ to{ stroke-dashoffset:0; } }

  .pp-assigned{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:14px;
    font-size:13.5px; font-weight:800; color:var(--green);
    opacity:0; transform:translateY(6px); transition:opacity .26s var(--ease), transform .26s var(--ease); }
  .pp-assigned.in{ opacity:1; transform:none; }

  /* and the card it lands on, back on the request */
  .sd-c.just-in{ animation:cardIn .5s var(--ease) both; }
  @keyframes cardIn{
    0%  { opacity:0; transform:translateY(9px); box-shadow:0 0 0 0 var(--primary-wash), var(--sh-1); }
    45% { opacity:1; transform:none;            box-shadow:0 0 0 4px var(--primary-wash), var(--sh-1); }
    100%{ opacity:1; transform:none;            box-shadow:0 0 0 0 rgba(0,0,0,0), var(--sh-1); }
  }

  /* the assign CTA on a provider profile reached from a request */
  .pp-assignbar{ display:flex; align-items:center; gap:9px; }
  .pp-assignbar .btn{ flex:1; }
  .pp-forreq{ display:flex; align-items:center; gap:9px; margin:16px 18px 0; padding:11px 13px; border-radius:13px;
    background:var(--primary-wash); border:1px solid color-mix(in srgb, var(--primary) 18%, transparent); }
  .pp-forreq svg{ flex:none; color:var(--primary-d); }
  .pp-forreq p{ font-size:12px; font-weight:600; color:var(--primary-d); line-height:1.45; }
  .pp-forreq p b{ font-weight:800; }

  @media (prefers-reduced-motion: reduce){
    .pp-av, .pp-av .ini, .pp-av .tick, .pp-assigned, .sd-c.just-in{
      transition-duration:.001ms !important; animation-duration:.001ms !important; }
  }
</style>
