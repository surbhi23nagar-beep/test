<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Wave Supervisor App</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  /* ============================================================
     WAVE SUPERVISOR APP
     Design language inherited from the Wave Resident App (Ocean).
     Same tokens, radii, shadows, chips, sheets, nav, status colours.
     Only the workflow and the information differ.
     ============================================================ */
  :root{
    --surface:#FFFFFF;
    --ink:#1B1D24; --ink-2:#474A53; --muted:#6B7079;
    --line:#ECEDF1; --line-2:#DEE0E6;
    --amber:#8C5D11; --amber-wash:#F4EAD4; --coral:#E0594A; --coral-wash:#FBE7E3;
    --sky:#4EA8DE;
    /* duotone icon tokens — identical to the Wave Resident App */
    --ic-accent:var(--sky); --ic-stroke:var(--ink);
    --green:#1E8A57; --green-wash:#E4F2EA;
    --blue:#3B5BA9;  --blue-wash:#E9EDF9;
    --red:#B3261E;   --red-wash:#F9E3E1;
    --violet:#7A4E9E; --violet-wash:#F0E9F7;
    --r-md:16px; --r-lg:22px; --r-xl:28px;
    --sh-1:0 1px 2px rgba(20,22,30,.04);
    --sh-2:0 3px 12px rgba(20,22,30,.05);
    --sh-3:0 8px 24px rgba(20,22,30,.08);
    --ease:cubic-bezier(.22,.61,.36,1);
    --chip:#F2F3F6; --sh-ic:none;
    /* Ocean */
    --bg:#EAF0F1; --bg-top:#F4F8F8; --surface-2:#F1F5F6;
    --primary:#0C7C8C; --primary-d:#0A5F6C; --primary-2:#2BA9BB; --primary-wash:#E3F1F3;
    --cta:#0C7C8C; --sh-cta:0 3px 12px rgba(20,22,30,.10);
    --ocean:linear-gradient(150deg,#16A9B1 0%,#0C7C8C 46%,#0A5F6C 100%);
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  body{ font-family:"Hanken Grotesk",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:var(--ink);
    background:#DFE3E8; -webkit-font-smoothing:antialiased; min-height:100vh; min-height:100dvh;
    display:flex; align-items:flex-start; justify-content:center; padding:34px 16px 60px; }
  button{ font-family:inherit; }

  .phone{ position:relative; width:390px; height:844px; background:linear-gradient(var(--bg-top), var(--bg) 240px); border-radius:46px;
    box-shadow:0 0 0 11px #14110C, 0 0 0 13px #2E2920, 0 30px 70px -20px rgba(20,16,10,.5); overflow:hidden; display:flex; flex-direction:column; }
  .notch{ position:absolute; top:11px; left:50%; transform:translateX(-50%); width:122px; height:30px; background:#14110C; border-radius:14px; z-index:210; }
  .statusbar{ position:relative; z-index:50; display:flex; align-items:center; justify-content:space-between; padding:15px 28px 6px; font-size:14px; font-weight:600; color:var(--ink); flex:none; }
  .statusbar .right{ display:flex; align-items:center; gap:7px; } .statusbar svg{ display:block; }
  .homebar{ position:absolute; bottom:7px; left:50%; transform:translateX(-50%); width:128px; height:5px; border-radius:5px; background:rgba(34,28,21,.28); z-index:207; }

  .stack{ position:relative; flex:1; min-height:0; }
  .screen{ position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; padding:0 0 120px; scrollbar-width:none; scroll-behavior:smooth; display:none; }
  .screen.on{ display:block; animation:fade .3s var(--ease) both; }
  .screen::-webkit-scrollbar{ display:none; }
  @keyframes fade{ from{ opacity:0; transform:translateY(7px);} to{ opacity:1; transform:none;} }

  /* ---- pushed pages (detail views) ---- */
  .page{ position:absolute; inset:0; z-index:60; background:linear-gradient(var(--bg-top), var(--bg) 240px); display:flex; flex-direction:column;
    transform:translateX(101%); transition:transform .32s var(--ease); visibility:hidden; }
  .page.on{ transform:none; visibility:visible; }
  .page-body{ flex:1; overflow-y:auto; overflow-x:hidden; scrollbar-width:none; padding-bottom:28px; }
  .page-body::-webkit-scrollbar{ display:none; }

  /* ---- app bar / top bar ---- */
  .appbar{ position:relative; z-index:5; background:var(--surface); padding-bottom:14px; box-shadow:0 8px 20px -10px rgba(20,22,30,.14); }
  .topbar{ display:flex; align-items:center; gap:12px; padding:6px 18px 10px; }
  .loc{ flex:1; min-width:0; display:flex; flex-direction:column; align-items:flex-start; gap:3px; }
  .loc .hi{ font-size:12.5px; color:var(--muted); font-weight:600; display:flex; align-items:center; gap:7px; }
  .loc .place{ display:inline-flex; align-items:center; gap:6px; max-width:100%; font-size:17px; font-weight:800; letter-spacing:-.3px; cursor:pointer; color:var(--ink); background:none; border:none; padding:0; }
  .loc .place-pin{ display:inline-flex; color:var(--primary-d); flex:none; }
  .loc .place-tx{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .loc .place-chev{ color:var(--muted); flex:none; margin-top:1px; }
  .topbar-act{ display:flex; align-items:center; gap:9px; flex:none; }
  .icon-btn{ width:44px; height:44px; border-radius:14px; border:1px solid var(--line-2); background:var(--surface); color:var(--ink-2); display:grid; place-items:center; flex:none; cursor:pointer; box-shadow:var(--sh-1); position:relative; transition:transform .16s var(--ease); }
  .icon-btn:active{ transform:scale(.93); }
  .icon-btn .dot{ position:absolute; top:8px; right:8px; min-width:16px; height:16px; padding:0 4px; border-radius:8px; background:var(--coral); color:#fff; font-size:9px; font-weight:800; display:grid; place-items:center; border:2px solid var(--surface); font-variant-numeric:tabular-nums; }
  .avatar-btn{ width:44px; height:44px; border-radius:14px; border:none; background:var(--ocean); color:#fff; font-size:14px; font-weight:800; display:grid; place-items:center; flex:none; cursor:pointer; box-shadow:var(--sh-cta); }

  .searchbar{ display:flex; align-items:center; gap:11px; margin:0 18px; padding:12px 12px 12px 16px; background:var(--surface-2); border:1px solid var(--line); border-radius:16px; color:var(--muted); cursor:text; transition:border-color .15s, box-shadow .15s, background .15s; }
  .searchbar:focus-within{ border-color:var(--primary); background:var(--surface); box-shadow:0 0 0 3px var(--primary-wash); }
  .searchbar > svg{ flex:none; }
  .searchbar input{ flex:1; min-width:0; border:none; outline:none; background:none; font-family:inherit; font-size:14px; font-weight:500; color:var(--ink); }
  .searchbar input::placeholder{ color:var(--muted); font-weight:500; }
  .searchbar .sb-x{ width:26px; height:26px; border-radius:50%; background:var(--line); color:var(--ink-2); border:none; display:grid; place-items:center; cursor:pointer; flex:none; }

  /* ---- page header (pushed views) ---- */
  .phead{ background:var(--surface); padding:6px 14px 13px; display:flex; align-items:center; gap:11px; box-shadow:0 8px 20px -12px rgba(20,22,30,.18); flex:none; z-index:5; }
  .phead .pb{ width:40px; height:40px; border-radius:13px; border:1px solid var(--line-2); background:var(--surface); color:var(--ink); display:grid; place-items:center; cursor:pointer; flex:none; transition:transform .15s var(--ease); }
  .phead .pb:active{ transform:scale(.92); }
  .phead .pt{ flex:1; min-width:0; }
  .phead .pt b{ display:block; font-size:16px; font-weight:800; letter-spacing:-.3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .phead .pt span{ display:block; font-size:11.5px; color:var(--muted); font-weight:600; margin-top:1px; font-variant-numeric:tabular-nums; }

  /* ---- section ---- */
  .sec{ margin-top:22px; }
  .sec-h{ display:flex; align-items:center; justify-content:space-between; margin-bottom:11px; padding-inline:20px; gap:10px; }
  .sec-h .ttl{ display:flex; flex-direction:column; gap:2px; min-width:0; }
  .sec-h h3{ font-size:17px; font-weight:800; letter-spacing:-.3px; display:flex; align-items:center; gap:8px; }
  .sec-h .sub{ font-size:11.5px; color:var(--muted); font-weight:500; }
  .sec-h .lnk{ font-size:12.5px; font-weight:700; color:var(--primary-d); display:flex; align-items:center; gap:3px; cursor:pointer; background:none; border:none; flex:none; }
  .cnt-pill{ font-size:10px; font-weight:800; color:#fff; background:var(--coral); border-radius:7px; min-width:18px; height:18px; padding:0 5px; display:inline-flex; align-items:center; justify-content:center; font-variant-numeric:tabular-nums; }
  .cnt-pill.calm{ background:var(--primary); }

  /* ---- KPI tiles ---- */
  .kpi{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:0 18px; }
  .kpi.kpi-2{ grid-template-columns:repeat(2,1fr); }
  .kpi.kpi-3{ grid-template-columns:repeat(3,1fr); }
  .kpi + .kpi{ margin-top:8px; }
  .kpi button{ background:var(--surface); border:1px solid var(--line); border-radius:15px; padding:11px 5px 10px; cursor:pointer; box-shadow:var(--sh-1); transition:transform .13s var(--ease), border-color .15s, box-shadow .15s; text-align:center; }
  .kpi button:active{ transform:scale(.95); }
  .kpi button.hot{ border-color:color-mix(in srgb, var(--coral) 45%, transparent); box-shadow:0 0 0 3px var(--coral-wash); }
  .kpi b{ display:block; font-size:20px; font-weight:800; letter-spacing:-.5px; font-variant-numeric:tabular-nums; line-height:1; color:var(--k,var(--ink)); }
  .kpi span{ display:block; font-size:9.5px; font-weight:700; color:var(--muted); margin-top:5px; letter-spacing:.01em; }

  /* ---- attention cards ---- */
  .attn{ margin:0 18px; display:flex; flex-direction:column; gap:10px; }
  .at{ display:flex; gap:11px; align-items:flex-start; width:100%; text-align:left; background:var(--surface); border:1px solid var(--line);
       border-left:3px solid var(--acc,var(--coral)); border-radius:16px; padding:12px 13px; box-shadow:var(--sh-2); cursor:pointer; transition:transform .13s var(--ease); }
  .at:active{ transform:scale(.985); }
  .at-ic{ width:36px; height:36px; border-radius:11px; display:grid; place-items:center; flex:none; background:var(--accw,var(--coral-wash)); color:var(--acc,var(--coral)); }
  .at-tx{ flex:1; min-width:0; }
  .at-tx b{ display:block; font-size:13.5px; font-weight:700; letter-spacing:-.15px; }
  .at-tx span{ display:block; font-size:11.5px; color:var(--muted); font-weight:500; margin-top:3px; line-height:1.4; }
  .at-tag{ display:inline-flex; align-items:center; gap:4px; font-size:9px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--acc,var(--coral)); background:var(--accw,var(--coral-wash)); border-radius:5px; padding:2px 6px; margin-top:8px; }
  .at-chv{ color:var(--muted); flex:none; align-self:center; }

  /* ---- filter chips ---- */
  .chiprow{ display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding:2px 18px 4px; }
  .chiprow::-webkit-scrollbar{ display:none; }
  .fchip{ flex:none; display:inline-flex; align-items:center; gap:6px; padding:8px 13px; border-radius:999px; border:1.5px solid var(--line-2); background:var(--surface); font-size:12.5px; font-weight:600; color:var(--ink-2); cursor:pointer; transition:.15s; white-space:nowrap; }
  .fchip:active{ transform:scale(.96); }
  .fchip.on{ background:var(--primary-wash); border-color:var(--primary); color:var(--primary-d); font-weight:700; }
  .fchip em{ font-style:normal; font-size:10.5px; font-weight:800; color:var(--muted); font-variant-numeric:tabular-nums; }
  .fchip.on em{ color:var(--primary-d); }

  /* ---- status pills ---- */
  .st{ display:inline-flex; align-items:center; gap:5px; font-size:10px; font-weight:800; border-radius:8px; padding:5px 9px; letter-spacing:.02em; white-space:nowrap; text-transform:uppercase; }
  .st i{ width:5px; height:5px; border-radius:50%; background:currentColor; flex:none; }
  .st.s-new{ color:var(--coral); background:var(--coral-wash); }
  .st.s-assigned{ color:var(--blue); background:var(--blue-wash); }
  .st.s-onway,.st.s-arrived,.st.s-hold{ color:var(--amber); background:var(--amber-wash); }
  .st.s-verified,.st.s-started{ color:var(--primary-d); background:var(--primary-wash); }
  .st.s-completed{ color:var(--green); background:var(--green-wash); }
  .st.s-cancelled{ color:var(--muted); background:var(--surface-2); }
  .st.s-esc{ color:var(--red); background:var(--red-wash); }
  .st.tiny{ font-size:9px; padding:3px 7px; }
  .flagpill{ display:inline-flex; align-items:center; gap:4px; font-size:9.5px; font-weight:800; border-radius:6px; padding:3px 7px; letter-spacing:.02em; color:var(--red); background:var(--red-wash); }
  .flagpill.warn{ color:var(--amber); background:var(--amber-wash); }
  .flagpill.info{ color:var(--blue); background:var(--blue-wash); }
  .flagpill.calm{ color:var(--primary-d); background:var(--primary-wash); }

  /* ---- request card ---- */
  .list{ padding:0 18px; }
  .rq{ display:block; width:100%; text-align:left; background:var(--surface); border:1px solid var(--line); border-radius:18px; box-shadow:var(--sh-2); padding:13px 14px; cursor:pointer; transition:transform .13s var(--ease); }
  .rq:active{ transform:scale(.987); }
  .rq + .rq{ margin-top:11px; }
  .rq.urgent{ border-color:color-mix(in srgb, var(--coral) 40%, transparent); }
  .rq-top{ display:flex; gap:11px; align-items:flex-start; }
  .rq-ic{ width:42px; height:42px; border-radius:13px; display:grid; place-items:center; flex:none; background:var(--accw); color:var(--acc); }
  .rq-mid{ flex:1; min-width:0; }
  .rq-id{ display:flex; align-items:center; gap:7px; font-size:9.5px; font-weight:800; letter-spacing:.06em; color:var(--muted); font-variant-numeric:tabular-nums; flex-wrap:wrap; }
  .rq-t{ font-size:14.5px; font-weight:700; letter-spacing:-.25px; margin-top:3px; line-height:1.25; }
  .rq-m{ font-size:11.5px; color:var(--muted); font-weight:600; margin-top:4px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .rq-m .dot{ width:3px; height:3px; border-radius:50%; background:var(--line-2); flex:none; }
  .rq-tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }
  .rq-foot{ display:flex; align-items:center; gap:9px; margin-top:11px; padding-top:11px; border-top:1px solid var(--line); }
  .rq-who{ display:flex; align-items:center; gap:8px; flex:1; min-width:0; font-size:12px; font-weight:600; color:var(--ink-2); }
  .rq-av{ width:26px; height:26px; border-radius:8px; display:grid; place-items:center; color:#fff; font-size:10px; font-weight:800; flex:none; }
  .rq-un{ font-size:12px; font-weight:600; color:var(--muted); font-style:italic; }
  .rq-act{ border:none; background:var(--cta); color:#fff; font-size:11.5px; font-weight:800; border-radius:10px; padding:8px 13px; cursor:pointer; box-shadow:var(--sh-cta); flex:none; transition:transform .13s var(--ease); }
  .rq-act:active{ transform:scale(.94); }
  .rq-act.ghost{ background:var(--surface); color:var(--primary-d); border:1px solid var(--line-2); box-shadow:none; }
  .rq-act.danger{ background:var(--coral); box-shadow:0 3px 10px rgba(224,89,74,.3); }

  /* ---- SLA meter ---- */
  .sla{ margin-top:11px; }
  .sla-top{ display:flex; justify-content:space-between; align-items:baseline; font-size:9.5px; font-weight:800; margin-bottom:5px; letter-spacing:.05em; text-transform:uppercase; }
  .sla-l{ color:var(--muted); }
  .sla-r{ font-variant-numeric:tabular-nums; }
  .sla-bar{ height:5px; border-radius:999px; background:var(--line); overflow:hidden; }
  .sla-fill{ height:100%; border-radius:999px; transition:width .5s var(--ease); }
  .sla.ok .sla-fill{ background:var(--green); } .sla.ok .sla-r{ color:var(--green); }
  .sla.warn .sla-fill{ background:#C4890F; } .sla.warn .sla-r{ color:var(--amber); }
  .sla.breach .sla-fill{ background:var(--coral); } .sla.breach .sla-r{ color:var(--coral); }

  /* ---- provider card ---- */
  /* ==== provider row — the Wave Resident helper-selection card ==============
     The resident app's maid list, structurally unchanged: a 54px photograph on
     a 16px-radius square, the name with the society's verification tick, the
     trade as a tinted pill next to the rating and its review count, then one
     line of small facts. Our addition is the meta bar underneath, borrowed
     from the same app's other helper card, carrying what the trade covers and
     how loaded the person is — the two things a supervisor needs that a
     resident hiring a maid does not.
     ========================================================================== */
  .pvc{ --dc:var(--primary); --dcw:var(--primary-wash);
    display:block; width:100%; text-align:left; background:var(--surface);
    border:1px solid var(--line); border-radius:18px; box-shadow:var(--sh-2);
    padding:13px 14px; margin-bottom:12px; cursor:pointer;
    transition:transform .14s var(--ease), box-shadow .16s var(--ease); }
  .pvc:active{ transform:scale(.99); box-shadow:var(--sh-1); }
  .pvc-top{ display:flex; align-items:flex-start; gap:13px; }
  .pvc-av{ width:54px; height:54px; flex:none; border-radius:16px; display:grid; place-items:center;
    color:#fff; font-weight:800; font-size:16px; letter-spacing:-.4px; }
  .pvc-m{ flex:1; min-width:0; }
  .pvc-nm{ display:flex; align-items:center; gap:6px; min-width:0; }
  .pvc-nm b{ font-size:15.5px; font-weight:800; letter-spacing:-.25px; color:var(--ink);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pvc-vf{ color:var(--green); flex:none; display:flex; }
  .pvc-r2{ display:flex; align-items:center; gap:8px; margin-top:6px; min-width:0; }
  .pvc-duty{ display:inline-flex; align-items:center; gap:5px; flex:0 1 auto; min-width:0;
    font-size:9.5px; font-weight:800; letter-spacing:.02em; padding:3px 9px; border-radius:999px;
    color:var(--dc); background:var(--dcw);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pvc-duty svg{ width:11px; height:11px; flex:none; }
  .pvc-rate{ display:inline-flex; align-items:center; gap:4px; flex:none; font-size:12.5px;
    font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; }
  .pvc-rc{ color:var(--muted); font-weight:600; }
  /* a block, not a flex row: text-overflow:ellipsis does nothing on a flex
     container, so the line used to be chopped mid-word at the card edge */
  .pvc-r3{ display:block; margin-top:6px; font-size:11.5px; font-weight:600; color:var(--muted);
    font-variant-numeric:tabular-nums; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .pvc-r3 svg{ width:12px; height:12px; vertical-align:-2px; color:var(--muted); }
  .pvc-dot{ display:inline-block; width:3px; height:3px; border-radius:50%;
    background:var(--line-2); vertical-align:2px; }
  .pvc-chev{ flex:none; color:var(--line-2); display:flex; align-self:center; }
  .pvc-st{ flex:none; display:inline-flex; align-items:center; gap:6px;
    font-size:11px; font-weight:800; }
  .pvc-st i{ width:6px; height:6px; border-radius:50%; background:currentColor; flex:none; }
  .pvc-st--ok{ color:var(--green); }
  .pvc-st--ok i{ box-shadow:0 0 0 3px var(--green-wash); }
  .pvc-st--busy{ color:var(--amber); }
  .pvc-bar{ display:flex; align-items:center; gap:9px; margin-top:12px; padding:9px 11px;
    background:var(--surface-2); border-radius:12px;
    font-size:11.5px; font-weight:700; color:var(--ink-2); }
  .pvc-seg{ flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pvc-load{ flex:none; font-size:11px; font-weight:800; color:var(--muted);
    font-variant-numeric:tabular-nums; }

  /* ==== availability filter — two cards, one always chosen =================
     Two numbers on two white tiles was a readout, not a control: nothing said
     it could be pressed, and nothing said which of the two you were looking
     at. These are cards with a mark, a count and the state in plain words,
     and the chosen one fills with its own colour — green when you are looking
     at who is free, amber when you are looking at who is not. The list under
     it is simply that set, so the screen only ever says the split once.
     ========================================================================== */
  .avf{ display:grid; grid-template-columns:1fr 1fr; gap:9px; margin:12px 18px 0; }
  .avf-b{ --k:var(--green); --kw:var(--green-wash);
    border:1.5px solid var(--line-2); background:var(--surface); border-radius:16px;
    padding:12px 13px 11px; font-family:inherit; text-align:left; cursor:pointer; min-width:0;
    transition:transform .13s var(--ease), border-color .16s var(--ease),
               background .16s var(--ease), box-shadow .16s var(--ease); }
  .avf-busy{ --k:var(--amber); --kw:var(--amber-wash); }
  .avf-b:active{ transform:scale(.97); }
  .avf-h{ display:flex; align-items:center; gap:9px; }
  .avf-ic{ width:28px; height:28px; flex:none; border-radius:9px; display:grid; place-items:center;
    background:var(--kw); color:var(--k); transition:background .16s var(--ease), color .16s var(--ease); }
  .avf-h b{ font-size:23px; font-weight:800; line-height:1; letter-spacing:-.7px;
    font-variant-numeric:tabular-nums; color:var(--ink); }
  .avf-l{ display:block; font-size:12.5px; font-weight:800; color:var(--ink); margin-top:9px; }
  .avf-s{ display:block; font-size:10.5px; font-weight:600; color:var(--muted); margin-top:2px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .avf-b.on{ background:var(--kw); border-color:var(--k);
    box-shadow:0 0 0 3px color-mix(in srgb, var(--k) 14%, transparent); }
  .avf-b.on .avf-ic{ background:var(--k); color:#fff; }
