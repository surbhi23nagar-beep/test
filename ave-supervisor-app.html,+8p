  /* the week strip and today's blocks — the resident app's .dav-* */
  .pp-days{ display:flex; gap:6px; margin:13px 0 4px; }
  .pp-day{ flex:1; text-align:center; padding:9px 0; border-radius:11px;
    font-size:11px; font-weight:800; background:var(--surface-2); color:var(--muted); }
  .pp-day.on{ background:var(--primary-wash); color:var(--primary-d); }
  .pp-slot{ display:flex; align-items:center; gap:11px; padding:13px 0 3px; }
