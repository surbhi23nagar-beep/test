/* ==========================================================================
   7. REQUESTS
   ========================================================================== */
/* Two filters live in the header because they describe the workload — how much
   matters (priority) and how much is moving (status). The other four live
   behind the filter button because they answer a different question: not "what
   does my day look like" but "where is that one request". A header that shows
   both is a header that shows nineteen chips and helps with neither. */
let fStatus = 'all', fPrio = 'all', fCat = 'all', fTower = 'all', fAge = 'any',
    fQuery = '', fAtt = false;

/* Eleven filters became six, because the supervisor's day only has six
   questions in it: everything, what has nobody on it, what has a name but has
   not moved, what is moving, what is stuck, what is finished. What was cut and
   why:

     To assign / New / Unassigned — three labels for one queue. The split was
       by age against ASSIGN_SLA, which put half the backlog behind a second
       tap and gave the two halves the same available action. One tab now, and
       the card says how long each has waited.
     Delayed / Escalated — these are not stages. A job can be In Progress and
       delayed and escalated at the same moment, so as peers in an exclusive
       row they were lying: picking Delayed threw away the stage you were in.
       They matter, so they survive as one switch that narrows whichever stage
       is open — see needsAttention().
     Cancelled — closed, and nothing left to decide. It has no action attached
       to it, which is the test. Still reachable under All.
   ------------------------------------------------------------------------- */
/* The labels are the resident-facing words, so a supervisor and a resident
   looking at the same request call its state the same thing. "To Assign" was
   the supervisor's own jargon for a request nobody had touched yet — the rest
   of the estate calls that a new request. */
const STATUS_FILTERS = [
  ['all','All'], ['toassign','New Request'], ['asg','Assigned'],
  ['prog','In Progress'], ['hold','Hold'], ['done','Completed']
];
function matchStatus(r, f){
  switch(f){
    case 'all':      return true;
    case 'toassign': return isUnassigned(r);
    case 'asg':      return r.st==='assigned';
    case 'prog':     return inProgress(r);
    case 'hold':     return r.st==='hold';
    case 'done':     return r.st==='completed';
  }
  return true;
}
/* Delayed and Escalated are not stages — a job can be In Progress and both at
   once — so they are one secondary switch in the filter sheet rather than a
   tab that would throw away the stage you were on. */
function needsAttention(r){ return isDelayed(r); }

const AGE_FILTERS = [['any','Any time'], ['1h','Last hour'], ['4h','Last 4 hours'], ['today','Today']];
function matchAge(r, f){
  if(f==='1h')  return r.age <= 60;
  if(f==='4h')  return r.age <= 240;
  return true;                       /* every request on this board is today's */
}
const TOWERS = ['Tower A','Tower B','Tower C','Tower D','Tower E','Tower F'];

/* One predicate, so a count and the list it promises can never disagree. Pass
   `skip` to leave one axis out — that is how a control prices its own options:
   the priority cells ask for everything except priority. */
function passes(r, skip){
  var q = fQuery.trim().toLowerCase();
  if(skip!=='status' && !matchStatus(r, fStatus))            return false;
  if(skip!=='prio'   && fPrio!=='all'  && r.prio!==fPrio)    return false;
  if(skip!=='cat'    && fCat!=='all'   && r.cat!==fCat)      return false;
  if(skip!=='tower'  && fTower!=='all' && r.tower!==fTower)  return false;
  if(skip!=='age'    && !matchAge(r, fAge))                  return false;
  if(skip!=='att'    && fAtt && !needsAttention(r))          return false;
  if(q){
    var hay = [r.id, r.res, r.flat, r.tower, r.t, CATS[r.cat].n, r.pid?prov(r.pid).n:''].join(' ').toLowerCase();
    if(hay.indexOf(q)<0) return false;
  }
  return true;
}
function filtered(){ return REQ.filter(function(r){ return passes(r); }); }
function countIf(skip, test){
  return REQ.filter(function(r){ return passes(r, skip) && test(r); }).length;
}
/* what the filter button is hiding — the header shows status and priority
   itself, so those are not news */
function sheetFilterCount(){
  return (fCat!=='all'?1:0) + (fTower!=='all'?1:0) + (fAge!=='any'?1:0) + (fAtt?1:0);
}
function anyFilter(){ return sheetFilterCount() || fStatus!=='all' || fPrio!=='all' || fQuery; }
function resetFilters(){
  fStatus='all'; fPrio='all'; fCat='all'; fTower='all'; fAge='any'; fQuery=''; fAtt=false;
}
function lbl(pairs, k){
  var m = pairs.filter(function(p){ return p[0]===k; })[0];
  return m ? m[1] : k;
}
function renderReq(){
  var rows = filtered(), nf = sheetFilterCount();
  var sub = [ fStatus==='all' ? 'Every status' : lbl(STATUS_FILTERS, fStatus) ];
  if(fPrio !== 'all')  sub.push(PRIO[fPrio].n + ' priority');
  if(fCat  !== 'all')  sub.push(CATS[fCat].n);
  if(fTower!== 'all')  sub.push(fTower);
  if(fAge  !== 'any')  sub.push(lbl(AGE_FILTERS, fAge).toLowerCase());
  if(fAtt)             sub.push('needing attention');

  $('#v-req').innerHTML =
    '<div class="appbar">'
      + '<div class="topbar"><div class="loc">'
        + '<span class="hi">Service requests</span>'
        + '<button class="place"><span class="place-tx">'
          + (fTower==='all' ? 'All towers' : fTower) + ' · Today</span>'
          + '<span class="place-chev">'+ic('down',15)+'</span></button></div>'
        + '<div class="topbar-act">'
          /* the dot counts only what the header cannot already show, so it
             never lights up for something visible two rows below it */
          + '<button class="icon-btn'+(nf?' on':'')+'" data-sheet="filters" aria-label="Filter">'
            + ic('filter',21) + (nf ? '<span class="fdot"></span>' : '') + '</button>'
        + '</div></div>'

      /* 1 — find one request */
      + '<div class="searchbar" style="margin-top:12px">'+ic('search',19)
        + '<input id="qbox" placeholder="Resident, flat, tower, ID, service" value="'+esc(fQuery)+'" />'
        + (fQuery?'<button class="sb-x" data-clearq="1">'+ic('x',14)+'</button>':'')
      + '</div>'

      /* 2 — how much is moving: exclusive stages, on a hairline */
      + '<div class="stabs" style="margin-top:14px">'
        + STATUS_FILTERS.map(function(s){
            var n = countIf('status', function(r){ return matchStatus(r, s[0]); });
            return '<button class="stab'+(fStatus===s[0]?' on':'')+'" data-fs="'+s[0]+'">'
              + s[1]+'<em>'+n+'</em></button>';
          }).join('')
      + '</div>'

      /* 3 — how much matters, within whatever the chips just narrowed to.
             Slate rather than red/blue/green: these three tiles used to be
             drawn in the same wash as the status pills inside the cards below
             them, so a red "High" tile and a red "Escalated" pill read as the
             same kind of thing. They are not — one is a filter, the other is
             a state — so the tiles are neutral now and only the selected one
             takes ink. */
      + '<div class="prio-row">'
        + PRIOKEYS.map(function(k){
            var n = countIf('prio', function(r){ return r.prio===k; });
            return '<button class="pr'+(fPrio===k?' on':'')+'" data-fp="'+k+'"'
              + ' aria-pressed="'+(fPrio===k)+'"><b>'+n+'</b><em>'+PRIO[k].n+'</em></button>';
          }).join('')
      + '</div>'
    + '</div>'

    + '<div class="sec" style="margin-top:16px">'
      + '<div class="sec-h"><div class="ttl"><h3>'+rows.length+' request'+(rows.length===1?'':'s')+'</h3>'
        + '<span class="sub">'+sub.join(' · ')+'</span></div>'
        + (anyFilter() ? '<button class="lnk" data-reset="1">Reset</button>' : '')+'</div>'
      + '<div class="list">'
        + (rows.length ? rows.map(reqCardLite).join('')
           : emptyState('search','No requests match','Nothing here matches the current status, priority and filters. Reset them to see the full board.'))
      + '</div>'
    + '</div>';
  var q = $('#qbox');
  if(q){ q.oninput = function(){ fQuery = q.value; var pos=q.selectionStart; renderReq(); var n=$('#qbox'); n.focus(); n.setSelectionRange(pos,pos); }; }
}

/* ==========================================================================
   8. PROVIDERS
   ========================================================================== */
/* Skill first, state second — that is the order the question is asked in.
   A supervisor never wants "everyone who is free"; they want a plumber, and
   then they want to know which plumbers are free. So the trade chips sit at
   the top and the Available / Busy split lives under them, describing the
   list the chips have already narrowed. */
/* Available and Busy are the filter, and the only one. They used to sit above
   a list that then re-announced the same split as two group headings — so the
   screen said "Available · 8" twice, and the tiles filtered a list that was
   already sorted by the thing they filtered on. Now one of the two is always
   chosen (Available to start, because that is the question a supervisor opens
   this screen with) and the list below is simply that set, unheaded. */
let fAvail = 'available', fPCat = 'all';
const AVSTATE = {
  available:{ n:'Available', sub:'free to take a job', ic:'checkC' },
  busy     :{ n:'Busy',      sub:'already on a job',   ic:'clock'  }
};
function renderProv(){
  var bySkill = PROV.filter(function(p){ return fPCat==='all' || p.cats.indexOf(fPCat)>=0; });
  var list = bySkill.filter(function(p){ return p.av===fAvail; });
  var A = AVSTATE[fAvail];

  $('#v-prov').innerHTML =
    '<div class="appbar">'
      + '<div class="topbar"><div class="loc">'
        + '<span class="hi">Service providers</span>'
        + '<button class="place"><span class="place-tx">'+PROV.length+' in your team</span></button></div>'
        + '<div class="topbar-act"><button class="icon-btn" data-sheet="addprov" aria-label="Add service provider">'
          + ic('plus',21)+'</button></div></div>'

      /* 1 — which trade */
      + '<div class="chiprow" style="margin-top:2px">'
        + '<button class="fchip'+(fPCat==='all'?' on':'')+'" data-fpc="all">All skills</button>'
        + CATKEYS.map(function(k){ var n = PROV.filter(function(p){return p.cats.indexOf(k)>=0;}).length;
            return '<button class="fchip'+(fPCat===k?' on':'')+'" data-fpc="'+k+'">'+ic(CATS[k].ic,14)+CATS[k].n+' <em>'+n+'</em></button>'; }).join('')
      + '</div>'

      /* 2 — and of those, who can take a job right now. Two real cards with a
             mark, a count and a plain-words caption, rather than two numbers
             floating on a white tile. */
      + '<div class="avf">'
        + ['available','busy'].map(function(k){
            var n = bySkill.filter(function(p){ return p.av===k; }).length;
            return '<button class="avf-b avf-'+k+(fAvail===k?' on':'')+'" data-fav="'+k+'"'
              + ' aria-pressed="'+(fAvail===k)+'">'
              + '<span class="avf-h"><span class="avf-ic">'+ic(AVSTATE[k].ic,16)+'</span>'
                + '<b>'+n+'</b></span>'
              + '<span class="avf-l">'+AVSTATE[k].n+'</span>'
              + '<span class="avf-s">'+AVSTATE[k].sub+'</span></button>';
          }).join('')
      + '</div>'
    + '</div>'

    + '<div class="sec" style="margin-top:16px"><div class="sec-h"><div class="ttl">'
      + '<h3>'+list.length+' '+A.n.toLowerCase()+'</h3>'
      + '<span class="sub">'+(fPCat==='all' ? 'Every trade' : CATS[fPCat].n)+' · '+A.sub+'</span></div>'
      + (fPCat!=='all' ? '<button class="lnk" data-fpc="all">All skills</button>' : '')+'</div>'
      + '<div class="list">'
        + (list.length ? list.map(function(p){ return provCard(p); }).join('')
           : emptyState('users','Nobody '+A.n.toLowerCase(),
               'No provider with this skill is '+A.n.toLowerCase()+' right now. Try another trade, or the other tab.'))
      + '</div></div>'
    + '<div class="ftr">Availability syncs live from the Handyman App</div>';
}

/* ==========================================================================
   9. ALERTS / ESCALATIONS
   ========================================================================== */
function renderAlert(){
  var at = attention();
  var groups = [
    ['Work disputed',        function(a){ return a.r.flags.indexOf('disputed')>=0; }],
    ['OTP problems',         function(a){ return a.r.flags.indexOf('otpfail')>=0 || a.r.flags.indexOf('otpnotrecd')>=0; }],
    ['Provider problems',    function(a){ return ['rejected','noresponse','wrongflat'].some(function(f){return a.r.flags.indexOf(f)>=0;}); }],
    ['Waiting for assignment',function(a){ return isUnassigned(a.r) && (a.r.age>ASSIGN_SLA || a.r.flags.indexOf('noprovider')>=0); }],
    ['Resident-side issues', function(a){ return ['resunavail','duplicate','wrongcat'].some(function(f){return a.r.flags.indexOf(f)>=0;}); }]
  ];
  var used = {};
  var body = groups.map(function(g){
    var rows = at.filter(function(a){ return !used[a.r.id] && g[1](a); });
    rows.forEach(function(a){ used[a.r.id]=1; });
    if(!rows.length) return '';
    return '<div class="grouplbl">'+g[0]+' · '+rows.length+'</div><div class="list">'
      + rows.map(alertCard).join('') + '</div>';
  }).join('');

  /* No header. The screen is a single ranked list of things that need a
     decision, and the block that sat above it was three restatements of that:
     a title naming the tab the nav already highlights, a count the nav badge
     already carries, and four shortcuts to other screens — on the one screen
     whose whole point is that you should be dealing with what is on it. The
     grouped labels below start the page instead. */
  $('#v-alert').innerHTML =
    '<div class="alert-top"></div>'
    + (at.length ? body : emptyState('shield','No open exceptions','Every request is moving on time. Delays, rejections and OTP failures show up here.'))
    + '<div class="ftr">Attention rules: unassigned &gt; 30 min · no provider update &gt; 45 min · SLA breach</div>';
}
/* ==========================================================================
   10. REQUEST DETAIL — problem → where → status → assignee → OTP → activity
   ========================================================================== */
let curId = null, tlOpen = false, descOpen = false;
function openDetail(id){
  curId = id; tlOpen = false; descOpen = false;
  renderDetail(); pushPage('p-detail'); $('#p-detail .page-body').scrollTop = 0;
}

function statusNote(r){
  if(r.st==='cancelled')  return 'Cancelled by '+r.cancelBy+' — “'+r.cancelWhy+'”.';
  if(r.flags.indexOf('disputed')>=0) return 'Marked complete by '+prov(r.pid).n+', then re-opened by the resident.';
  if(r.st==='completed')  return 'Closed at '+r.doneAt+(r.rating?' · resident rated '+r.rating+'★':'')+'.';
  if(r.flags.indexOf('otpfail')>=0)  return 'Provider is at the door but the OTP will not verify.';
  if(r.flags.indexOf('resunavail')>=0) return 'Resident was not at home. Waiting for a new slot.';
  if(r.flags.indexOf('rejected')>=0) return 'The assigned provider rejected the job. Needs a new one.';
  if(r.flags.indexOf('noresponse')>=0) return 'No update from '+prov(r.pid).n+' for 45 minutes.';
  if(r.flags.indexOf('noprovider')>=0) return 'No '+CATS[r.cat].n+' technician has been free since it was raised.';
  if(isUnassigned(r)) return r.age>ASSIGN_SLA
      ? 'Nobody assigned yet — '+mins(r.age)+' past the '+ASSIGN_SLA+' minute target.'
      : 'Waiting for you to pick a provider.';
  if(r.st==='assigned') return prov(r.pid).n+' has the job and is yet to set off.';
  if(r.st==='onway')    return prov(r.pid).n+' is on the way to '+r.flat+'.';
  if(r.st==='arrived')  return prov(r.pid).n+' has arrived and is waiting for OTP verification.';
  if(r.st==='started')  return 'Work in progress since '+r.startedAt+'.';
  return STATUS[r.st].n+'.';
}
/* exception callouts, rendered inside the status block so nothing floats loose */
function detNotes(r){
  var out = [];
  if(r.flags.indexOf('duplicate')>=0) out.push(['info','copy','Looks like a duplicate of '+r.dupOf+' — same flat, same service.']);
  if(r.flags.indexOf('wrongcat')>=0)  out.push(['','alert','Reads like '+CATS[r.suggestCat].n+', not '+CATS[r.cat].n+'. Change it before assigning.']);
  if(r.flags.indexOf('otpfail')>=0)   out.push(['dgr','key',(r.otpTries||2)+' of 3 OTP attempts used. One more failure locks the code.']);
  if(r.flags.indexOf('noprovider')>=0)out.push(['','users','Pull someone from another zone, or book an outside vendor.']);
  return out.map(function(o){
    return '<div class="note '+(o[0]||'')+'">'+ic(o[1],16)+'<p>'+esc(o[2])+'</p></div>';
  }).join('');
