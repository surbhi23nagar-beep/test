const TABS = [
  { k:'home',  v:'v-home',  n:'Home',      i:'home'  },
  { k:'req',   v:'v-req',   n:'Requests',  i:'list'  },
  { k:'prov',  v:'v-prov',  n:'Providers', i:'users' },
  { k:'alert', v:'v-alert', n:'Alerts',    i:'alert' }
];
let tab = 'home';
function renderNav(){
  var c = counts();
  $('#nav').innerHTML = TABS.map(function(t){
    var badge = '';
    if(t.k==='req'   && (c.nw+c.un)) badge = '<span class="nb">'+(c.nw+c.un)+'</span>';
    if(t.k==='alert' && attention().length) badge = '<span class="nb">'+attention().length+'</span>';
    return '<button class="ni'+(tab===t.k?' active':'')+'" data-tab="'+t.k+'">'+NAVIC[t.k]+'<span>'+t.n+'</span>'+badge+'</button>';
  }).join('');
}
function go(k){
  tab = k;
  TABS.forEach(function(t){ $('#'+t.v).classList.toggle('on', t.k===k); });
  renderNav();
  ({ home:renderHome, req:renderReq, prov:renderProv, alert:renderAlert })[k]();
  $('#'+TABS.filter(function(t){return t.k===k;})[0].v).scrollTop = 0;
}
function pushPage(id){ $('#'+id).classList.add('on'); }
function popPage(id){ $('#'+id).classList.remove('on'); }

/* ==========================================================================
   6. HOME — two stacked sections, one card.

   New requests first, because that queue is the only one where the supervisor
   is the thing holding the work up. Recent requests below it, ranked by how
   loudly they are asking for a decision, which is where high-priority and
   escalated work surfaces. The old Urgent/Latest segmented control is gone:
   it hid half the screen behind a tap and made the supervisor choose a lens
   before they had seen anything.

   The card carries no buttons. Assignment happens on the request itself, so an
   Assign shortcut on a summary card only invited the supervisor to dispatch
   somebody before reading what the problem was. Tapping the card opens it;
   that is the only affordance, and it needs no chevron to announce itself.
   ========================================================================== */
let homeQ = '', homeSearch = false;
let RECENT = ['C-1102', 'SR-4821', 'Plumbing', 'Tower A'];
const SUGGEST = [
  ['Unassigned', 'clock'], ['Delayed', 'alert'],
  ['Tower C', 'pin'], ['Electrical', 'elec']
];
const STCOL = { new:'var(--coral)', assigned:'var(--blue)', onway:'#C4890F', arrived:'#C4890F',
  verified:'var(--primary)', started:'var(--primary)', hold:'#C4890F', completed:'var(--green)', cancelled:'#A0A4AD' };

function ago(m){
  if(m<1)    return 'just now';
  if(m<60)   return m+' min ago';
  if(m<1440){ var h=Math.floor(m/60); return h+' hr'+(h===1?'':'s')+' ago'; }
  return 'yesterday';
}
function hl(s, q){
  s = esc(s); if(!q) return s;
  var i = s.toLowerCase().indexOf(q.toLowerCase()); if(i<0) return s;
  return s.slice(0,i)+'<mark>'+s.slice(i,i+q.length)+'</mark>'+s.slice(i+q.length);
}

/* One pill, and the most serious thing wins it. Red belongs to the two states
   somebody is escalating about; a job simply waiting for a name is grey. */
const STPILL = {
  new      :['New request',  'idle'],
  assigned :['Assigned',     'info'],
  onway    :['On the way',   'live'],
  arrived  :['Arrived',      'live'],
  verified :['OTP verified', 'live'],
  started  :['Working',      'live'],
  hold     :['Hold',         'warn'],
  completed:['Completed',    'ok'  ],
  cancelled:['Cancelled',    'idle']
};
function rcState(r){
  if(r.prio==='urgent' && isOpen(r))  return ['High',      'crit'];
  if(r.flags.indexOf('disputed')>=0)  return ['Re-opened', 'warn'];
  return STPILL[r.st];
}

/* The one line that varies between cards: what has actually happened. Plain
   words, no colour — the state pill above is what carries urgency. */
function rcNote(r){
  var F = r.flags, p = r.pid ? prov(r.pid) : null, first = p ? p.n.split(' ')[0] : '';
  if(F.indexOf('disputed')>=0)   return 'Resident says the issue is still not fixed';
  if(F.indexOf('otpfail')>=0)    return 'OTP not verified — ' + first + ' is at the door';
  if(F.indexOf('rejected')>=0)   return 'Provider declined the job';
  if(F.indexOf('noresponse')>=0) return 'No update from ' + first + ' for 45 minutes';
  if(F.indexOf('noprovider')>=0) return 'No ' + CATS[r.cat].n.toLowerCase() + ' technician free';
  if(F.indexOf('resunavail')>=0) return 'Resident unavailable — needs rescheduling';
  if(F.indexOf('wrongcat')>=0)   return 'May belong to ' + CATS[r.suggestCat].n;
  if(F.indexOf('duplicate')>=0)  return 'Looks like the same problem as ' + r.dupOf;
  if(isUnassigned(r))            return r.age > ASSIGN_SLA
                                   ? 'Waiting to be assigned for ' + mins(r.age)
                                   : 'Waiting to be assigned';
  if(r.st==='assigned')          return first + ' accepted, not started yet';
  if(r.st==='onway')             return first + ' is on the way';
  if(r.st==='arrived')           return first + ' has reached the flat';
  if(r.st==='verified')          return 'OTP verified — work about to start';
  if(r.st==='started')           return first + ' is working on it now';
  if(r.st==='hold')              return 'On hold — visit to be rescheduled';
  if(r.st==='completed')         return 'Completed by ' + first;
  if(r.st==='cancelled')         return 'Cancelled';
  return '';
}

/* ---------- the home card ----------
   problem icon → problem → flat & tower → who raised it → what is happening → when */
function rcCard(a){
  var r = a.r || a, st = rcState(r);
  return '<div class="rc" role="button" tabindex="0" data-open="'+r.id+'">'
    + '<div class="rc-top">'
      + '<span class="rc-ic">'+issueIc(r,24)+'</span>'
      + '<span class="rc-b">'
        + '<span class="rc-r"><span class="rc-t">'+esc(r.t)+'</span>'
          + '<span class="rc-st '+st[1]+'">'+st[0]+'</span></span>'
        + '<span class="rc-r"><span class="rc-where">'+ic('pin',13)
          + '<b>'+r.flat+'</b><i class="sep">·</i><span class="tw">'+esc(r.tower)+'</span></span></span>'
        + '<span class="rc-r"><span class="rc-by">'+ic('user',13)+esc(r.res)+'</span></span>'
      + '</span>'
    + '</div>'
    + '<div class="rc-band">'
      + '<span class="rc-note">'+esc(rcNote(r))+'</span>'
      + '<span class="rc-when">'+ic('clock',13)+ago(r.age)+'</span>'
    + '</div></div>';
}

/* ---------- the list card ----------
   icon → problem → tower & flat → time → what has been done

   Six words on the state, and nothing about how important it is. The status
   here is the plain pipeline stage, not rcState(): the home card promotes
   Urgent and Escalated into the pill because home is a triage view, but in a
   list you are scanning for "has anyone picked this up", and a pill that
   sometimes answers a different question breaks the column. */
const STCARD = {
  new      :['New request','warn'],
  assigned :['Assigned',   'info'],
  onway    :['In progress','live'],
  arrived  :['In progress','live'],
  verified :['In progress','live'],
  started  :['In progress','live'],
  hold     :['Hold',       'idle'],
  completed:['Completed',  'ok'  ],
  cancelled:['Cancelled',  'idle']
};
/* A material hold says so on the card. It costs nothing — same pill, same
   column, same On Hold tab — and it is the difference between "somebody paused
   this" and "this is waiting on a part", which is exactly the thing the
   supervisor would otherwise have to open the request to find out. */
function stCard(r){
  return STCARD[r.st];
}
/* Alerts is the same board seen through one question — why does this need me
   now — so it is the same card with one line added, not a second card system.
   The reason goes in the band under a hairline, tinted by severity, because on
   this screen the reason is the thing being scanned and the status is context.
   Everything the old card put here (request id, service caption, flag pills,
   SLA bar, avatar, a row of action buttons) said it twice: the group heading
   above already names the category, and the reason line says the rest. */
function alertCard(a){ return rcLite(a.r, a); }
function reqCardLite(r){ return rcLite(r, null); }

function rcLite(r, why){
  var st = stCard(r);
  return '<div class="rc rc-lite'+(why?' rc-alert':'')+'" role="button" tabindex="0" data-open="'+r.id+'">'
    + '<div class="rc-top">'
      + '<span class="rc-ic">'+issueIc(r,24)+'</span>'
      + '<span class="rc-b">'
        /* status sits on the title line, top-right, so it lands at the same
            point on every card whatever the problem statement does below it —
            a column the eye can run down. On the time row it drifted with the
            title's wrap and stopped being scannable. */
        + '<span class="rc-head"><span class="rc-t">'+esc(r.t)+'</span>'
          + '<span class="rc-st '+st[1]+'">'+st[0]+'</span></span>'
        /* tower first, then the flat in bold — the tower narrows the walk, the
           flat is the number checked against the door */
        + '<span class="rc-where">'+ic('pin',13)+'<span class="tw">'+esc(r.tower)+'</span>'
          + '<i class="sep">·</i><b>'+r.flat+'</b></span>'
        + '<span class="rc-meta"><span class="rc-when">'+ic('clock',13)+ago(r.age)+'</span></span>'
      + '</span>'
    + '</div>'
    + (why ? '<div class="rc-band"><span class="rc-why" style="--acc:'+why.acc+'">'
        + ic(why.ic,14)+'<span>'+esc(why.why)+'</span></span></div>' : '')
    + '</div>';
}

/* Home is two stacked sections rather than one list under a switch, the same
   shape the Wave Resident app uses.

   new    — nobody has been sent yet. This is the only queue where the
            supervisor is the blocker, so it leads the screen and is kept
            deliberately short: one or two cards, newest first. A long list
            here would turn the section into a second Requests tab.
   recent — everything else that is live, ranked by how loudly it is asking
            for a decision (attention() first, high priority next), then by
            how recently it moved. Urgent work surfaces here without needing
            a tab of its own.  */
function homeSplit(){
  var neu = REQ.filter(function(r){ return isOpen(r) && isUnassigned(r); })
                .slice().sort(function(a,b){ return a.age - b.age; });
  var newIds = {};
  neu.slice(0,2).forEach(function(r){ newIds[r.id] = 1; });

  var rank = {};
  attention().forEach(function(a, i){ if(!(a.r.id in rank)) rank[a.r.id] = i; });

  var recent = REQ.filter(function(r){ return isOpen(r) && !newIds[r.id]; })
    .slice().sort(function(a,b){
      var ra = (a.id in rank) ? rank[a.id] : 900, rb = (b.id in rank) ? rank[b.id] : 900;
      if(ra !== rb) return ra - rb;
      var pa = PRIO[a.prio].r, pb = PRIO[b.prio].r;
      if(pa !== pb) return pa - pb;
      return a.age - b.age;
    });

  var seen = {}, urgent = [];
  attention().forEach(function(a){ if(!seen[a.r.id]){ seen[a.r.id]=1; urgent.push(a); } });
  return { neu:neu, recent:recent, urgent:urgent };
}

/* ---------- compact row, still used by the inline search results ---------- */
function latestRow(r){
  var C = CATS[r.cat];
  return '<button class="fr" style="--acc:'+C.acc+';--accw:'+C.accw+'" data-open="'+r.id+'">'
    + '<span class="fr-ic">'+svcIc(r.cat,19)+'</span>'
    + '<span class="fr-tx"><span class="fr-t">'+C.n+' · '+r.flat+'</span>'
      + '<span class="fr-m">'+esc(r.t)+'</span></span>'
    + '<span class="fr-r"><span class="fr-ago">'+ago(r.age)+'</span>'
      + '<span class="fr-dot" style="background:'+STCOL[r.st]+'"></span></span></button>';
}

/* ---------- inline search ---------- */
function searchPanel(){
  var q = homeQ.trim();
  if(!q){
    var recentReq = REQ.filter(isOpen).slice(0,3);
    return '<div style="margin-top:22px">'
      + '<div class="srch-lbl">Recent searches</div>'
      + '<div class="srch-chips">'
        + RECENT.map(function(x){ return '<button class="srch-chip" data-hs="'+esc(x)+'">'+ic('hist',14)+esc(x)+'</button>'; }).join('')
      + '</div>'
      + '<div class="srch-lbl" style="margin-top:24px">Jump to</div>'
      + '<div class="srch-chips">'
        + SUGGEST.map(function(s){ return '<button class="srch-chip" data-hs="'+s[0]+'">'+ic(s[1],14)+s[0]+'</button>'; }).join('')
      + '</div>'
      + '<div class="srch-lbl" style="margin-top:24px">Open right now</div>'
      + '<div class="feed">'+recentReq.map(latestRow).join('')+'</div>'
      + '</div>';
  }
  var lq = q.toLowerCase();
  var reqs = REQ.filter(function(r){
    return [r.id, r.res, r.flat, r.tower, r.t, CATS[r.cat].n, r.pid?prov(r.pid).n:''].join(' ').toLowerCase().indexOf(lq)>=0; });
  var seen = {}, people = [];
  REQ.forEach(function(r){
    var key = r.res+'|'+r.flat;
    if(seen[key]) return;
    if((r.res+' '+r.flat+' '+r.tower).toLowerCase().indexOf(lq)<0) return;
    seen[key] = 1; people.push(r);
  });
  var cats = CATKEYS.filter(function(k){ return CATS[k].n.toLowerCase().indexOf(lq)>=0; });
  var provs = PROV.filter(function(p){
    return (p.n+' '+p.skill+' '+p.cats.map(function(k){return CATS[k].n;}).join(' ')).toLowerCase().indexOf(lq)>=0; });
  var total = reqs.length + people.length + cats.length + provs.length;

  if(!total) return '<div style="margin-top:12px">'
    + emptyState('search','Nothing matches “'+esc(q)+'”','Search by resident name, flat number, tower, request ID or service type.')+'</div>';

  function group(label, n, body){
    return '<div class="srch-lbl" style="margin-top:22px">'+label+' · '+n+'</div><div class="feed">'+body+'</div>';
  }
  var out = '<div style="margin-top:18px">';
  if(reqs.length) out += group('Requests', reqs.length, reqs.slice(0,6).map(function(r){
    return '<button class="sres" style="--acc:'+CATS[r.cat].acc+';--accw:'+CATS[r.cat].accw+'" data-open="'+r.id+'">'
      + '<span class="sres-ic">'+svcIc(r.cat,19)+'</span>'
      + '<span class="sres-tx"><b>'+hl(r.t,q)+'</b><span>'+hl(r.id,q)+' · '+hl(r.flat,q)+' · '+STATUS[r.st].n+'</span></span>'
      + '<span class="fr-dot" style="background:'+STCOL[r.st]+'"></span></button>'; }).join(''));
  if(people.length) out += group('Residents &amp; flats', people.length, people.slice(0,5).map(function(r){
