let pickReq = null, pickSel = null, pickMode = 'assign', pickReason = null;
function openPick(id, mode, reason){
  pickReq = id; pickSel = null; pickMode = mode || 'assign'; pickReason = reason || null;
  renderPick(); pushPage('p-pick'); $('#p-pick .page-body').scrollTop = 0;
}

/* one card, every fact the decision needs, in the order it is asked for:
   who → what trade → how loaded → how far → how good → what else they do */
function renderPick(){
  var r = req(pickReq), C = CATS[r.cat];
  var reassign = pickMode === 'reassign';
  var pool = PROV.filter(function(p){ return !(reassign && p.id === r.pid); });

  var fit   = pool.filter(function(p){ return p.cats.indexOf(r.cat)>=0; });
  var free  = fit.filter(function(p){ return p.av==='available'; })
                 .sort(function(a,b){ return a.load-b.load || a.eta-b.eta; });
  var busy  = fit.filter(function(p){ return p.av!=='available'; })
                 .sort(function(a,b){ return a.load-b.load; });
  var cross = pool.filter(function(p){ return p.cats.indexOf(r.cat)<0 && p.av==='available'; })
                 .sort(function(a,b){ return a.load-b.load; });
  var best = free[0];

  function group(label, n, list){
    if(!list.length) return '';
    return '<div class="grouplbl">'+label+' · '+n+'</div>'
      + '<div class="list">'+list.map(function(p){ return provCard(p, 'pick'); }).join('')+'</div>';
  }

  $('#p-pick').innerHTML =
    '<div class="phead"><button class="pb" data-back="p-pick">'+ic('back',20)+'</button>'
      + '<div class="pt"><b>'+(reassign?'Choose a replacement':'Choose Provider')+'</b>'
      + '<span>'+r.id+' · '+C.n+' · '+r.flat+'</span></div></div>'

    + '<div class="page-body">'
      + '<div style="margin:16px 18px 0">'
        + (free.length
            ? '<div class="note info">'+ic('info',16)+'<p><b>'+best.n+'</b> is the best match — free, '
              + best.eta+' min away, '+best.load+' active job'+(best.load===1?'':'s')+'.</p></div>'
            : '<div class="note dgr">'+ic('alert',16)+'<p>No '+C.n+' technician is free right now. '
              + 'Pick someone from another trade below, or someone already on a job.</p></div>')
        + (reassign && pickReason
            ? '<div class="note" style="margin-top:9px">'+ic('refresh',16)
              + '<p>Reassigning because: <b>'+esc(pickReason)+'</b>. A new OTP is issued and the old one dies.</p></div>'
            : '')
      + '</div>'

      + group('Available '+C.n, free.length, free)
      + group('Other trades, free now', cross.length, cross.slice(0,4))
      + group('Not free right now', busy.length, busy)

      + '<div style="margin:20px 18px 0">'
        + '<div class="note">'+ic('key',16)+'<p>Open a provider to see their rating, reviews, hours and current load '
        + 'before you commit. A 6-digit service OTP is generated the moment you assign, and appears in '
        + 'the Resident App and the Handyman App at the same time.</p></div></div>'
      + '<div class="ftr">Tap a provider to open their full profile, then assign from there</div>'
    + '</div>';
}

