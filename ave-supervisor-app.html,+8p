/* ==========================================================================
   15. ACTIONS
   ========================================================================== */
function doAssign(id, pid){
  var r = req(id), p = prov(pid);
  r.pid = pid; r.st = 'assigned'; r.assignedAt = NOW;
  r.otp = genOtp(); r.otpSt = 'pending'; r.otpExp = 15; r.otpTries = 0;
  ['rejected','noprovider','noresponse'].forEach(function(f){ unflag(r,f); });
  p.load++; if(p.av==='available') p.av = 'busy';
  r.tl.push([NOW,'assigned','Assigned to '+p.n,'By you · '+p.skill]);
  r.tl.push([NOW,'otp','Service OTP generated', r.otp+' · delivered to Resident App + Handyman App']);
  toast('Assigned to '+p.n+' · OTP '+r.otp+' is live in both apps', 'key');
}
function doReassign(id, pid, reason){
  var r = req(id), old = r.pid ? prov(r.pid) : null, p = prov(pid), oldOtp = r.otp;
  if(old){ old.load = Math.max(0, old.load-1); if(!old.load && old.av==='busy') old.av = 'available'; }
  r.pid = pid; r.st = 'assigned'; r.assignedAt = NOW;
  r.otp = genOtp(); r.otpSt = 'pending'; r.otpExp = 15; r.otpTries = 0;
  addflag(r,'reassigned');
  ['rejected','noresponse','otpfail','resunavail'].forEach(function(f){ unflag(r,f); });
  p.load++; if(p.av==='available') p.av = 'busy';
  r.tl.push([NOW,'alert','Reassigned — '+reason, old ? old.n+' removed from this request' : '']);
  if(oldOtp) r.tl.push([NOW,'otp','OTP '+oldOtp+' invalidated','The previous provider can no longer start this job']);
  r.tl.push([NOW,'assigned','Assigned to '+p.n,'By you']);
  r.tl.push([NOW,'otp','New OTP generated', r.otp+' · delivered to both apps']);
  toast('Reassigned to '+p.n+' · new OTP '+r.otp+' issued', 'refresh');
}
function doCancel(id, reason){
  var r = req(id);
  if(r.pid){ var p = prov(r.pid); p.load = Math.max(0,p.load-1); if(!p.load && p.av==='busy') p.av = 'available'; }
  if(r.otp && r.otpSt==='pending'){ r.tl.push([NOW,'otp','OTP '+r.otp+' invalidated','Request cancelled']); r.otpSt = 'expired'; }
  r.st = 'cancelled'; r.cancelBy = 'Supervisor'; r.cancelWhy = reason; r.flags = [];
  r.tl.push([NOW,'cancelled','Cancelled by supervisor','Reason: '+reason+' · resident notified']);
  toast('Request cancelled · resident notified', 'xC');
}
function doHold(id, slot){
  var r = req(id);
  r.st = 'hold'; r.slot = slot; addflag(r,'resunavail');
  if(r.otpSt==='pending'){ r.otpSt = 'expired'; r.tl.push([NOW,'otp','OTP '+r.otp+' expired','Visit rescheduled']); }
  r.tl.push([NOW,'cancelled','Visit rescheduled to '+slot,'Awaiting resident confirmation']);
  toast('New slot sent to the resident for confirmation', 'cal');
}
/* ---- material: the four moves ------------------------------------------
   stop → (approve, if money is involved) → material lands → resume. The
   request sits at st:'hold' for the whole of it, so nothing anywhere else has
   to learn a new status, and it can never be resolved along the way. */
function pname(r){ return r.pid && prov(r.pid) ? prov(r.pid).n : 'The provider'; }
function pfirst(r){ return pname(r).split(' ')[0]; }

function doDispute(id, mode){
  var r = req(id);
  unflag(r,'disputed');
  if(mode==='verify'){
    r.tl.push([NOW,'resolved','Dispute closed — work verified','By you']); toast('Verified and closed');
  }else{
    r.st = 'assigned'; r.doneAt = null; r.otp = genOtp(); r.otpSt = 'pending'; r.otpExp = 15;
    r.age = 0; addflag(r,'reassigned');
    if(mode==='other'){ r.st = 'new'; r.pid = null; r.otp = null; r.otpSt = 'none';
      r.tl.push([NOW,'alert','Reopened — needs a different provider','Back in the unassigned queue']); toast('Reopened · pick a new provider','refresh'); }
    else { r.assignedAt = NOW;
      r.tl.push([NOW,'alert','Reopened — same provider sent back','New OTP '+r.otp+' issued']); toast('Reopened · '+prov(r.pid).n+' notified','refresh'); }
  }
}
function doMerge(id){
  var r = req(id), o = req(r.dupOf);
  r.st = 'cancelled'; r.cancelBy = 'Supervisor'; r.cancelWhy = 'Merged into '+o.id; r.flags = [];
  r.tl.push([NOW,'cancelled','Merged into '+o.id,'One provider will handle both in a single visit']);
  o.tl.push([NOW,'raised','Merged in '+r.id,'"'+r.t+'" added to this request']);
  o.d = o.d + ' Also: ' + r.t + '.';
  toast('Merged into '+o.id+' · resident sees one request', 'copy');
}
function doCategory(id, cat){
  var r = req(id); if(!cat || !CATS[cat] || cat===r.cat){ toast('Service unchanged','info'); return; }
  var from = CATS[r.cat].n;
  r.cat = cat; unflag(r,'wrongcat'); r.suggestCat = null;
  r.tl.push([NOW,'alert','Service changed: '+from+' → '+CATS[cat].n,'By you · SLA recalculated to '+mins(CATS[cat].sla)]);
  toast('Now a '+CATS[cat].n+' request · SLA '+mins(CATS[cat].sla), 'edit');
}
function doComplete(id){
  var r = req(id);
  if(r.pid){ var p = prov(r.pid); p.load = Math.max(0,p.load-1); if(!p.load && p.av==='busy') p.av = 'available'; }
  r.st = 'completed'; r.doneAt = NOW; r.flags = [];
  r.tl.push([NOW,'resolved','Marked completed by supervisor','Resident asked to rate the visit']);
  toast('Completed · resident asked for a rating');
}
function doOtp(id, what){
  var r = req(id);
  if(what==='resend'){
    r.tl.push([NOW,'otp','OTP resent to resident','Push + SMS to +91 '+r.ph]);
    toast('OTP '+r.otp+' resent to '+r.res+' by push and SMS', 'send');
  }else if(what==='push'){
    r.tl.push([NOW,'otp','OTP re-delivered to provider','Handyman App push']);
    toast('Code pushed to '+(r.pid?prov(r.pid).n:'the provider')+' again', 'send');
  }else if(what==='regen'){
    var old = r.otp; r.otp = genOtp(); r.otpSt = 'pending'; r.otpExp = 15; r.otpTries = 0; unflag(r,'otpfail');
    r.tl.push([NOW,'otp','OTP regenerated', old+' invalidated · new code '+r.otp+' sent to both apps']);
    toast('New OTP '+r.otp+' · old code is dead', 'refresh');
  }else if(what==='manual'){
    if(!r.otp) r.otp = genOtp();
    r.otpSt = 'verified'; r.otpAt = NOW; unflag(r,'otpfail');
    if(['assigned','onway','arrived'].indexOf(r.st)>=0){ r.st = 'started'; r.startedAt = NOW; }
    r.tl.push([NOW,'otp','OTP verified by supervisor','Override · logged against SUP-114']);
    r.tl.push([NOW,'progress','Work started','']);
    toast('Verified from here · work started', 'shield');
  }
}

/* ==========================================================================
   16. EVENTS
   ========================================================================== */
function hit(e, sel){ return e.target.closest ? e.target.closest(sel) : null; }

document.addEventListener('click', function(e){
  var t;

  /* --- sheet internals first --- */
  if(t = hit(e,'[data-close]'))     { closeSheet(); return; }
  if(t = hit(e,'[data-pick]'))      { keepDraft(); SH.pick = t.dataset.pick; drawSheet(); return; }
  if(t = hit(e,'[data-sub]'))       { SH.sub = t.dataset.sub; drawSheet(); return; }
  if(t = hit(e,'[data-sreason]'))   { SH.reason = t.dataset.sreason; drawSheet(); return; }
  if(t = hit(e,'[data-more-act]'))  {
    var act = t.dataset.moreAct, id = SH.id; closeSheet();
    if(act==='print'){ toast('Request summary copied to clipboard', 'copy'); return; }
    /* choosing a provider is a screen, not a sheet — see openPick() */
    if(act==='assign'){ setTimeout(function(){ openPick(id, 'assign'); }, 180); return; }
    if(act==='resume'){ var rq2 = req(id); if(rq2.hold && rq2.hold.state!=='ready') doMatReady(id); refreshAll(); }
    setTimeout(function(){ openSheet(act, id); }, 180); return;
  }
  if(t = hit(e,'[data-do]')){
    var d = t.dataset.do, id = SH.id, r = id ? req(id) : null;
    switch(d){
      case 'reassign-next':        var rsn = SH.reason; closeSheet();
                                   setTimeout(function(){ openPick(id, 'reassign', rsn); }, 180); break;
      case 'otp-resend':           doOtp(id,'resend'); drawSheet(); refreshAll(); break;
      case 'otp-push':             doOtp(id,'push');   drawSheet(); refreshAll(); break;
      case 'otp-regen':            doOtp(id,'regen');  drawSheet(); refreshAll(); break;
      case 'otp-manual':           doOtp(id,'manual'); closeSheet(); refreshAll(); break;
      case 'escalate':             doEscalate(id, SH.pick, SH.reason); closeSheet(); refreshAll(); break;
      case 'cancel':               doCancel(id, SH.reason); closeSheet(); refreshAll(); break;
      case 'cancel-from-hold':     closeSheet(); setTimeout(function(){ openSheet('cancel', id); },180); break;
      case 'hold':                 doHold(id, SH.pick); closeSheet(); refreshAll(); break;
      case 'mat-ok':               doMaterial(id,true);  closeSheet(); refreshAll(); break;
      case 'mat-no':               doMaterial(id,false); closeSheet(); refreshAll(); break;
      case 'mat-need':             keepDraft(); doMatNeed(id, SH.pick, SH.items, SH.cost);
                                   closeSheet(); refreshAll(); break;
      case 'resume':               doResume(id, SH.pick||'now', SH.sub); closeSheet(); refreshAll(); break;
      case 'dispute':              doDispute(id, SH.pick); closeSheet(); refreshAll(); break;
      case 'merge':                doMerge(id); closeSheet(); refreshAll(); break;
      case 'keepboth':             unflag(req(id),'duplicate'); closeSheet(); refreshAll(); toast('Kept as a separate request','checkC'); break;
      case 'category':             doCategory(id, SH.pick || r.suggestCat); closeSheet(); refreshAll(); break;
      /* last line of defence: whatever route got here, a stopped job does not
         close. The sheets hide the button, this refuses the action. */
      case 'complete':             if(!canResolve(r)){ toast('Still on hold — resume the work first','pause'); break; }
                                   doComplete(id); closeSheet(); refreshAll(); break;
      case 'broadcast':            closeSheet(); toast('Broadcast sent to '+PROV.length+' providers','send'); break;
      case 'addprov':              closeSheet(); toast('Invite sent — they appear here once they log in','send'); break;
      case 'setav':                var p = prov(id); p.av = SH.pick || p.av; closeSheet(); refreshAll();
                                   toast(p.n+' set to '+p.av,'user'); break;
    }
    return;
  }

  /* --- navigation --- */
  if(t = hit(e,'[data-back]'))    { popPage(t.dataset.back); return; }
  if(t = hit(e,'[data-tab]'))     { ['p-detail','p-pick','p-provider','p-profile'].forEach(popPage);
                                    if(t.dataset.tab!=='home'){ homeSearch=false; homeQ=''; }
                                    go(t.dataset.tab); return; }
  if(t = hit(e,'[data-profile]')) { renderProfile(); pushPage('p-profile'); return; }
  if(t = hit(e,'[data-signout]')) { toast('Signed out of Wave Supervisor','logout');
                                   /* Sign out used to raise a toast and leave the supervisor
                                      standing in the app they had just left. With a gate in
                                      front of the app there is somewhere to go, so it goes
                                      there — after unwinding to a clean home so the app is
                                      not mid-detail behind the fade. */
                                   ['p-detail','p-pick','p-provider','p-profile'].forEach(popPage);
                                   closeSheet(); go('home');
                                   setTimeout(function(){ if(window.openAuthGate) window.openAuthGate(); }, 420);
                                   return; }
  if(t = hit(e,'[data-gosearch]')){ go('req'); setTimeout(function(){ var q=$('#qbox'); if(q) q.focus(); },260); return; }

  /* --- request detail: expanders --- */
  if(t = hit(e,'[data-tl]'))      { tlOpen = !tlOpen; renderDetail(); return; }
  if(t = hit(e,'[data-desc]'))    { descOpen = !descOpen; renderDetail(); return; }

  /* --- home: inline search --- */
  if(t = hit(e,'[data-hs]'))      { homeSearchFor(t.dataset.hs); return; }
  if(t = hit(e,'[data-hcancel]')) { homeSearch = false; homeQ = ''; renderHome(); return; }
  if(t = hit(e,'[data-hclear]'))  { homeQ = ''; renderHome(); var n=$('#hqbox'); if(n) n.focus(); return; }
  if(t = hit(e,'[data-gotocat]')) { resetFilters(); fCat = t.dataset.gotocat;
                                    homeSearch = false; homeQ = ''; go('req'); return; }

  /* --- filters --- */
  /* header controls — tapping the active one clears it, so the count and the
     filter stay the same control */
  if(t = hit(e,'[data-fs]'))      { fStatus = t.dataset.fs; renderReq(); return; }
  if(t = hit(e,'[data-fp]'))      { fPrio = (fPrio===t.dataset.fp ? 'all' : t.dataset.fp); renderReq(); return; }
  /* sheet controls — apply live behind the sheet, then redraw it so its own
     counts and chips agree with the list */
  if(t = hit(e,'[data-fc]'))      { fCat   = t.dataset.fc;   renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-ftw]'))     { fTower = t.dataset.ftw;  renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-fp2]'))     { fPrio  = t.dataset.fp2;  renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-fs2]'))     { fStatus= t.dataset.fs2;  renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-fag]'))     { fAge   = t.dataset.fag;  renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-att]'))     { fAtt = !fAtt; renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-resetsheet]')){ resetFilters(); renderReq(); drawSheet(); return; }
  if(t = hit(e,'[data-reset]'))   { resetFilters(); renderReq(); return; }
  if(t = hit(e,'[data-clearq]'))  { fQuery=''; renderReq(); return; }
  /* one of the two is always on — this is a tab, not a clearable filter */
  if(t = hit(e,'[data-fav]'))     { fAvail = t.dataset.fav; renderProv();
                                    $('#v-prov').scrollTop = 0; return; }
  if(t = hit(e,'[data-fpc]'))     { fPCat = t.dataset.fpc; renderProv(); return; }
  /* Delayed and Escalated are no longer stages, so the two home tiles that
     named them land on All with the attention switch thrown — the same set,
     without pretending it is a place in the pipeline. */
  if(t = hit(e,'[data-kpi]'))     {
    var k = t.dataset.kpi;
    var m = { all:'all', toassign:'toassign', new:'toassign', unas:'toassign', asg:'asg',
              prog:'prog', hold:'hold', done:'done', del:'all', esc:'all', canc:'all' };
    resetFilters();
    fAtt = (k==='del' || k==='esc');
    fStatus = m[k] || 'all';
    homeSearch = false; homeQ = ''; go('req'); return;
  }

  /* --- request actions --- */
  if(t = hit(e,'[data-assign]'))   { openPick(t.dataset.assign, 'assign');      return; }
  if(t = hit(e,'[data-pkpick]'))   { pickSel = (pickSel===t.dataset.pkpick ? null : t.dataset.pkpick);
                                     renderPick(); return; }
  if(t = hit(e,'[data-pkdo]'))     {
    if(!pickSel) return;
    if(pickMode==='reassign') doReassign(pickReq, pickSel, pickReason || 'Reassigned by supervisor');
    else                      doAssign(pickReq, pickSel);
    popPage('p-pick'); refreshAll(); return;
  }
  if(t = hit(e,'[data-reassign]')) { openSheet('reassign', t.dataset.reassign); return; }
  if(t = hit(e,'[data-otp]'))      { openSheet('otp',      t.dataset.otp);      return; }
  if(t = hit(e,'[data-cancel]'))   { openSheet('cancel',   t.dataset.cancel);   return; }
  if(t = hit(e,'[data-hold]'))     { openSheet('hold',     t.dataset.hold);     return; }
  if(t = hit(e,'[data-dispute]'))  { openSheet('dispute',  t.dataset.dispute);  return; }
  if(t = hit(e,'[data-duplicate]')){ openSheet('duplicate',t.dataset.duplicate);return; }
  if(t = hit(e,'[data-category]')) { openSheet('category', t.dataset.category); return; }
  if(t = hit(e,'[data-complete]')) { openSheet('complete', t.dataset.complete); return; }
  if(t = hit(e,'[data-more]'))     { openSheet('more',     t.dataset.more);     return; }
  if(t = hit(e,'[data-track]'))    { openSheet('track',    t.dataset.track);    return; }
  /* "the material is here" and "start again" are one tap when the state is
     already ready, and two when it is not — the sheet is where the same-visit
     or fresh-visit decision gets made */
  if(t = hit(e,'[data-resume]'))   { var rr = req(t.dataset.resume);
                                     if(rr.hold && rr.hold.state!=='ready') doMatReady(rr.id);
                                     openSheet('resume', rr.id); refreshAll(); return; }
  if(t = hit(e,'[data-matremind]')){ var rm = req(t.dataset.matremind);
                                     rm.hold.told = NOW;
                                     rm.tl.push([NOW,'progress','Resident reminded about the material',esc(rm.hold.items)]);
                                     refreshAll(); toast('Reminder sent to '+rm.res,'send'); return; }
  if(t = hit(e,'[data-pic]'))     { var pp = t.dataset.pic.split('|');
                                    toast('Photo '+pp[1]+' of '+req(pp[0]).pics+' from the resident','img'); return; }
  if(t = hit(e,'[data-callres]'))  { var rr=req(t.dataset.callres); toast('Calling '+rr.res+' · +91 '+rr.ph,'phone'); return; }
  if(t = hit(e,'[data-callprov]')) { var r3=req(t.dataset.callprov); toast('Calling '+prov(r3.pid).n+' · +91 '+prov(r3.pid).ph,'phone'); return; }
  if(t = hit(e,'[data-callprovid]')){ var p3=prov(t.dataset.callprovid); toast('Calling '+p3.n+' · +91 '+p3.ph,'phone'); return; }
  if(t = hit(e,'[data-setav]'))    { openSheet('setav', t.dataset.setav); return; }
  if(t = hit(e,'[data-broadcast]')){ openSheet('broadcast'); return; }
  if(t = hit(e,'[data-sheet]'))    { openSheet(t.dataset.sheet, SH.id); return; }

  /* --- open detail (checked last so inner buttons win) --- */
  if(t = hit(e,'[data-prov]'))     { openProv(t.dataset.prov); return; }
  if(t = hit(e,'[data-open]'))     { openDetail(t.dataset.open); return; }

  if(e.target.id === 'scrim') closeSheet();
});
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeSheet(); });
$('#scrim').addEventListener('click', closeSheet);

/* ==========================================================================
   17. BOOT
   ========================================================================== */
$('#clock').textContent = NOW.replace(' AM','').replace(' PM','');
renderNav();
go('home');
</script>

<script>
/* ==========================================================================
   18. AUTH GATE — splash · login · OTP · onboarding
   Self-contained: it only ever touches #authGate and, once, calls into the
   app to open the gate again from Sign out. Kept after BOOT so the app is
   already rendered behind the gate when it fades.
   ========================================================================== */
(function(){
  var G  = function(id){ return document.getElementById(id); };
  var gate = G('authGate');
  if(!gate) return;

  /* ---- screen router -------------------------------------------------------
     Forward: the outgoing screen takes .past and recedes left while the next
     slides in from the right. Backward: the outgoing screen returns to the
     right and the target sheds .past. Each screen holds exactly one state, so
     two screens never cross and leave a seam mid-transition.
     -------------------------------------------------------------------------- */
  var ORDER = ['auSplash','auLogin','auOtp'];
  function show(id){
    var ti = ORDER.indexOf(id);
    if(id !== 'auOtp') clearTimeout(verifyT);   /* see the verify handler below */
    ORDER.forEach(function(s,i){
      var el = G(s);
      el.classList.toggle('active', i === ti);
      el.classList.toggle('past',   i <  ti);
    });
    /* the splash puts a photograph behind the statusbar; login and OTP are
       light. Toggled here so the clock stays legible on both. */
    gate.classList.toggle('on-dark', id === 'auSplash');
  }

  /* ---- 1 · splash ---------------------------------------------------------- */
  G('toLogin').addEventListener('click', function(){
    show('auLogin');
    setTimeout(function(){ phone.focus(); phone.setSelectionRange(phone.value.length, phone.value.length); }, 460);
  });

  /* ---- 2 · login ----------------------------------------------------------- */
  var phone = G('auPhone'), terms = G('auTerms'), next = G('auPhoneNext'), termsOK = false;
  function digits(s){ return (String(s).match(/\d/g) || []).join(''); }
  function fmt(s){ var d = digits(s).slice(0,10); return d.length > 5 ? d.slice(0,5)+' '+d.slice(5) : d; }
  function refreshCTA(){ next.disabled = !(termsOK && digits(phone.value).length === 10); }
  phone.addEventListener('input', function(){ phone.value = fmt(phone.value); refreshCTA(); });
  function toggleTerms(){
    termsOK = !termsOK;
    terms.classList.toggle('on', termsOK);
    terms.setAttribute('aria-checked', termsOK);
    refreshCTA();
  }
  terms.addEventListener('click', toggleTerms);
  terms.addEventListener('keydown', function(e){
    if(e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); toggleTerms(); }
  });
  G('loginBack').addEventListener('click', function(){ show('auSplash'); });
  next.addEventListener('click', function(){
    G('auOtpPhone').textContent = fmt(phone.value);
    clearOtp(); startResend(); show('auOtp');
    setTimeout(function(){ boxes[5].focus(); }, 460);
  });

  /* ---- 3 · OTP ------------------------------------------------------------- */
  var CODE = '123456';                                   /* demo credential, pre-filled */
  var verifyT = null;                                    /* pending "signed in" dialog */
  var boxes = [].slice.call(G('auOtpRow').querySelectorAll('.ao-box'));
  function markFilled(){ boxes.forEach(function(b){ b.classList.toggle('filled', !!b.value); }); }
  function clearOtp(){
    boxes.forEach(function(b){ b.classList.remove('ok','err'); });
    G('auOtpError').hidden = true;
  }
  markFilled();
  boxes.forEach(function(box, i){
    box.addEventListener('input', function(){
      box.value = (box.value.match(/\d/) || [''])[0];
      clearOtp(); markFilled();
      if(box.value && i < 5) boxes[i+1].focus();
    });
    box.addEventListener('keydown', function(e){
      if(e.key === 'Backspace' && !box.value && i > 0){
        boxes[i-1].focus(); boxes[i-1].value = ''; markFilled();
      }
    });
  });
  G('auOtpBack').addEventListener('click',   function(){ show('auLogin'); });
  G('auOtpChange').addEventListener('click', function(){ show('auLogin'); });

  var resendT = null;
  function startResend(){
    var left = 30, btn = G('auOtpResend');
    btn.disabled = true; clearInterval(resendT);
    function tick(){
      btn.textContent = left > 0 ? 'Resend in 0:'+String(left).padStart(2,'0') : 'Resend code';
      if(left <= 0){ btn.disabled = false; clearInterval(resendT); }
      left--;
    }
    tick(); resendT = setInterval(tick, 1000);
  }
  G('auOtpResend').addEventListener('click', function(){ if(!this.disabled) startResend(); });

  G('auOtpVerify').addEventListener('click', function(){
    var code = boxes.map(function(b){ return b.value; }).join('');
    if(code.length < 6){
      (boxes.filter(function(b){ return !b.value; })[0] || boxes[0]).focus();
      return;
    }
    clearOtp();
    if(code === CODE){
      boxes.forEach(function(b){ b.classList.add('ok'); });
      clearInterval(resendT);
      /* The dialog waits 480ms so the boxes are seen turning green first. That
         gap is long enough to tap Back or Change number, which would have left
         the confirmation opening over the login screen — so the timer is held
         and cancelled by show(), and the callback re-checks it is still here. */
      clearTimeout(verifyT);
      verifyT = setTimeout(function(){
        if(!G('auOtp').classList.contains('active')) return;
        G('auDlgScrim').classList.add('on'); G('auDlg').classList.add('on');
      }, 480);
    } else {
      boxes.forEach(function(b){ b.classList.add('err'); });
      G('auOtpError').hidden = false;
    }
  });
  function closeDlg(){ G('auDlgScrim').classList.remove('on'); G('auDlg').classList.remove('on'); }
  /* Straight into the app: the supervisor signs in to work a queue, not to be
     walked through a feature tour, and this one is opened many times a shift. */
  G('auDlgContinue').addEventListener('click', function(){ closeDlg(); enterApp(); });
  G('auDlgScrim').addEventListener('click', closeDlg);

  /* ---- in and back out ----------------------------------------------------- */
  function enterApp(){ gate.classList.add('gone'); clearInterval(resendT); }

  /* Sign out used to raise a toast and leave the supervisor exactly where they
     were — with a gate in front of the app there is somewhere to go, so it
     goes there. The gate reopens on the splash with the OTP screen reset. */
  window.openAuthGate = function(){
    clearOtp(); markFilled();
    boxes.forEach(function(b, i){ b.value = String(i + 1); });
    markFilled();
    termsOK = false; terms.classList.remove('on'); terms.setAttribute('aria-checked','false');
    refreshCTA();
    show('auSplash');
    gate.classList.remove('gone');
  };

  /* ---- init ---------------------------------------------------------------- */
  var appClock = G('clock');
  if(appClock) G('auClock').textContent = appClock.textContent;
  refreshCTA();
  show('auSplash');
})();
</script>

</body>
</html>
