  .pv-av{ width:44px; height:44px; border-radius:50%; display:grid; place-items:center; color:#fff; font-weight:800; font-size:14px; flex:none; position:relative; }
  .pv-av i{ position:absolute; right:-1px; bottom:-1px; width:13px; height:13px; border-radius:50%; border:2.5px solid var(--surface); }
  .pv-s{ font-size:11.5px; color:var(--muted); font-weight:600; margin-top:3px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .pv-s .dot{ width:3px; height:3px; border-radius:50%; background:var(--line-2); }
  .av-available{ background:var(--green); } .av-busy{ background:#C4890F; }
  .avlbl{ font-size:9px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; border-radius:5px; padding:3px 7px; white-space:nowrap; }
  .avlbl.available{ color:var(--green); background:var(--green-wash); }
  .avlbl.busy{ color:var(--amber); background:var(--amber-wash); }

  /* ---- generic card ---- */
  .card{ margin:0 18px; background:var(--surface); border:1px solid var(--line); border-radius:18px; box-shadow:var(--sh-2); padding:15px 16px; }
  .card + .card{ margin-top:12px; }
  .card-h{ display:flex; align-items:center; gap:10px; margin-bottom:12px; }
  .card-h b{ flex:1; font-size:11px; font-weight:800; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); }
  .card-h .lnk{ font-size:11.5px; font-weight:800; color:var(--primary-d); background:none; border:none; cursor:pointer; flex:none; }
  .kv{ display:flex; align-items:flex-start; justify-content:space-between; gap:14px; padding:9px 0; }
  .kv + .kv{ border-top:1px solid var(--line); }
  .kv .k{ font-size:12px; color:var(--muted); font-weight:600; flex:none; }
  .kv .v{ font-size:13px; font-weight:700; color:var(--ink); text-align:right; min-width:0; }
  .kv .v small{ display:block; font-size:11px; color:var(--muted); font-weight:600; margin-top:2px; }

  /* ---- stepper ---- */
  .stp{ display:flex; align-items:flex-start; padding:4px 0 2px; }
  .stp-i{ flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; position:relative; min-width:0; }
  .stp-i::before{ content:""; position:absolute; top:10px; left:-50%; width:100%; height:2px; background:var(--line); }
  .stp-i:first-child::before{ display:none; }
  .stp-i.done::before, .stp-i.cur::before{ background:var(--primary-2); }
  .stp-d{ width:21px; height:21px; border-radius:50%; background:var(--surface-2); color:var(--muted); display:grid; place-items:center; z-index:1; border:2px solid var(--surface); }
  .stp-i.done .stp-d{ background:var(--primary); color:#fff; }
  .stp-i.cur .stp-d{ background:var(--primary); color:#fff; box-shadow:0 0 0 4px var(--primary-wash); }
  .stp-i.stop .stp-d{ background:var(--coral); color:#fff; box-shadow:0 0 0 4px var(--coral-wash); }
  .stp-i span{ font-size:8px; font-weight:700; color:var(--muted); text-align:center; line-height:1.18; letter-spacing:.01em; }
  .stp-i.done span, .stp-i.cur span{ color:var(--primary-d); }
  .stp-i.stop span{ color:var(--coral); }

  /* ---- OTP ---- */
  .otp-box{ background:var(--primary-wash); border:1px solid color-mix(in srgb, var(--primary) 22%, transparent); border-radius:16px; padding:14px 15px; }
  .otp-box.dead{ background:var(--surface-2); border-color:var(--line-2); }
  .otp-box.okd{ background:var(--green-wash); border-color:color-mix(in srgb, var(--green) 25%, transparent); }
  .otp-h{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .otp-h b{ font-size:10px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:var(--primary-d); }
  .otp-box.dead .otp-h b{ color:var(--muted); } .otp-box.okd .otp-h b{ color:var(--green); }
  .otp-d{ display:flex; gap:7px; margin-top:11px; }
  .otp-d i{ flex:1; height:44px; border-radius:11px; background:var(--surface); display:grid; place-items:center; font-style:normal; font-size:20px; font-weight:800; font-variant-numeric:tabular-nums; color:var(--ink); box-shadow:var(--sh-1); }
  .otp-box.dead .otp-d i{ color:var(--muted); }
  .otp-meta{ display:flex; align-items:center; gap:7px; margin-top:11px; font-size:11px; font-weight:700; color:var(--primary-d); font-variant-numeric:tabular-nums; }
  .otp-box.dead .otp-meta{ color:var(--muted); } .otp-box.okd .otp-meta{ color:var(--green); }
  .otp-sync{ display:flex; gap:7px; margin-top:11px; }
  .otp-sync span{ flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; background:var(--surface); border-radius:10px; padding:8px 4px; font-size:9px; font-weight:700; color:var(--muted); text-align:center; line-height:1.2; box-shadow:var(--sh-1); }
  .otp-sync span b{ font-size:8.5px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:var(--green); }
  .otp-sync span b.wait{ color:var(--amber); } .otp-sync span b.off{ color:var(--muted); }

  /* ---- timeline ---- */
  .al-row{ display:flex; gap:12px; position:relative; padding-bottom:16px; }
  .al-row:last-child{ padding-bottom:0; }
  .al-row .ald{ width:30px; height:30px; border-radius:9px; flex:none; display:grid; place-items:center; z-index:1; background:var(--surface-2); color:var(--muted); }
