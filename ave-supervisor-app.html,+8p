     this sheet is the one place every filter can be seen at once. Selections
     apply live to the list behind the sheet — an Apply button would make the
     supervisor commit before seeing what they had chosen, and the count on
     the close button already reports the result. */
  filters:function(){
    function chips(attr, opts, cur, ico){
      return '<div class="fchips">' + opts.map(function(o){
        return '<button class="fchip'+(cur===o[0]?' on':'')+'" data-'+attr+'="'+o[0]+'">'
          + (ico&&o[2] ? ic(o[2],14) : '') + o[1] + '</button>'; }).join('') + '</div>';
    }
    function sec(title, note, body){
      return '<div class="fsec"><div class="fsec-h"><b>'+title+'</b>'
        + (note?'<span>'+note+'</span>':'')+'</div>'+body+'</div>';
    }
    var rows = filtered().length;
    return '<h3>Filter requests</h3>'
      + '<div class="sub">'+(sheetFilterCount()||fStatus!=='all'||fPrio!=='all'
