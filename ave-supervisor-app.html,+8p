   3. DERIVED STATE
   ========================================================================== */
const ASSIGN_SLA = 30;                       /* minutes to assign a request  */
function req(id){ return REQ.filter(function(r){ return r.id===id; })[0]; }
function isOpen(r){ return r.st!=='completed' && r.st!=='cancelled'; }
function isUnassigned(r){ return r.st==='new'; }
function inProgress(r){ return ['onway','arrived','verified','started'].indexOf(r.st)>=0; }
function isDelayed(r){
  if(!isOpen(r)) return r.flags.indexOf('disputed')>=0;
  /* a held job is stopped, not late — what makes it late is the block itself
     going stale, so that is the only thing checked while it is on hold */
  if(onHold(r)) return holdOverdue(r);
  if(isUnassigned(r) && r.age > ASSIGN_SLA) return true;
  if(slaPct(r) >= 100) return true;
  return ['noresponse','resunavail','otpfail','noprovider'].some(function(f){ return r.flags.indexOf(f)>=0; });
}
/* ==== blocked on material ==================================================
   A job that cannot finish because something has to be bought is not late, not
   resolved, and not "in progress" either — it is stopped, and the supervisor's
   only useful question is who is fetching the thing and when it lands. So it
   is a hold with a reason attached rather than a status of its own: it stays
   under On Hold where every other stopped job lives, and the reason travels on
   the request.

   Two sources, because the two behave completely differently:

     provider — the technician goes to the market. Money is involved, so it
       needs the supervisor's approval before it is spent, and then it is a
       short wait measured in minutes.
     resident — the flat has to supply the part. Nobody can approve anything;
       the supervisor's job is to tell the resident what is needed and chase
       it, and the wait is measured in hours or days.

   The clock: time spent blocked is not time the team wasted, so activeAge()
   subtracts it and the resolution SLA stops while a request is on hold. What
   replaces it is holdOverdue() — the block itself going stale, which is the
   thing actually worth an alert.
   ========================================================================== */
function onHold(r){ return r.st==='hold'; }
function holdMins(r){ return r.holdMins || 0; }
/* the block has outlived what it should have taken */
function holdOverdue(r){
  if(!onHold(r)) return false;
  var lim = 240;
  return holdMins(r) > lim;
}
/* nothing may close while the work is physically unfinished */
function canResolve(r){ return isOpen(r) && !onHold(r); }

function activeAge(r){ return Math.max(0, r.age - holdMins(r)); }
function slaPct(r){ return Math.min(140, Math.round(activeAge(r) / CATS[r.cat].sla * 100)); }
function slaLeft(r){ return CATS[r.cat].sla - activeAge(r); }
function mins(m){ var a=Math.abs(m); return a<60 ? a+'m' : Math.floor(a/60)+'h '+(a%60?(a%60)+'m':''); }
function slaClass(r){ var p=slaPct(r); return p>=100?'breach':(p>=70?'warn':'ok'); }
function counts(){
  var c={ nw:0, un:0, asg:0, prog:0, done:0, del:0, canc:0, hold:0 };
  REQ.forEach(function(r){
    if(r.st==='completed'){ c.done++; }
    else if(r.st==='cancelled'){ c.canc++; }
    else{
      if(isUnassigned(r)){ if(r.age>ASSIGN_SLA) c.un++; else c.nw++; }
      else if(r.st==='assigned') c.asg++;
      else if(r.st==='hold') c.hold++;
      else c.prog++;
    }
    if(isDelayed(r)) c.del++;
  });
  return c;
}
/* everything that must be acted on right now, most urgent first */
function attention(){
  var out=[];
  REQ.forEach(function(r){
    if(!isOpen(r) && r.flags.indexOf('disputed')<0) return;
    if(r.flags.indexOf('disputed')>=0){ out.push({r:r,acc:'var(--red)',accw:'var(--red-wash)',ic:'flag',tag:'Work disputed',why:'Resident says the work is not completed',rank:1}); return; }
    if(r.flags.indexOf('otpfail')>=0){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'key',tag:'OTP failed',why:'2 of 3 attempts used · resident did not receive the OTP',rank:2}); return; }
    if(r.flags.indexOf('rejected')>=0){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'xC',tag:'Rejected',why:'Provider rejected · needs reassignment',rank:2}); return; }
    if(r.flags.indexOf('noresponse')>=0){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'clock',tag:'No response',why:'No update from '+prov(r.pid).n+' for 45 min',rank:2}); return; }
    if(r.flags.indexOf('noprovider')>=0){ out.push({r:r,acc:'var(--amber)',accw:'var(--amber-wash)',ic:'users',tag:'No provider',why:'No '+CATS[r.cat].n+' technician free · '+mins(r.age)+' unassigned',rank:2}); return; }
    if(r.flags.indexOf('resunavail')>=0){ out.push({r:r,acc:'var(--amber)',accw:'var(--amber-wash)',ic:'user',tag:'On hold',why:'Resident unavailable · reschedule pending',rank:3}); return; }
    if(r.flags.indexOf('duplicate')>=0){ out.push({r:r,acc:'var(--blue)',accw:'var(--blue-wash)',ic:'copy',tag:'Duplicate?',why:'Looks like a duplicate of '+r.dupOf,rank:3}); return; }
    if(r.flags.indexOf('wrongcat')>=0){ out.push({r:r,acc:'var(--amber)',accw:'var(--amber-wash)',ic:'alert',tag:'Wrong service',why:'Reads like '+CATS[r.suggestCat].n+' — change before assigning',rank:3}); return; }
    if(isUnassigned(r) && r.age>ASSIGN_SLA){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'clock',tag:'Unassigned',why:'Waiting for assignment for '+mins(r.age),rank:2}); return; }
    if(r.prio==='urgent' && isUnassigned(r)){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'alert',tag:'High priority',why:'Safety issue · assign immediately',rank:1}); return; }
    if(slaPct(r)>=100){ out.push({r:r,acc:'var(--coral)',accw:'var(--coral-wash)',ic:'clock',tag:'SLA breached',why:'Resolution SLA crossed by '+mins(slaLeft(r)),rank:2}); }
  });
  out.sort(function(a,b){ return a.rank-b.rank || b.r.age-a.r.age; });
  return out;
}
