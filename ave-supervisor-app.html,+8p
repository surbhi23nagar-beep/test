  .al-row::before{ content:""; position:absolute; left:14.5px; top:30px; bottom:0; width:2px; background:var(--line); }
  .al-row:last-child::before{ display:none; }
  .al-tx{ flex:1; padding-top:2px; min-width:0; }
  .al-tx b{ font-size:12.5px; font-weight:700; color:var(--ink); }
  .al-tx span{ display:block; font-size:11px; color:var(--muted); font-weight:500; margin-top:3px; line-height:1.45; font-variant-numeric:tabular-nums; }

  /* ---- buttons ---- */
  .btn{ display:flex; align-items:center; justify-content:center; gap:8px; width:100%; border:none; cursor:pointer; border-radius:14px; padding:14px; font-size:14.5px; font-weight:700; transition:transform .14s var(--ease); }
  .btn:active{ transform:scale(.985); }
