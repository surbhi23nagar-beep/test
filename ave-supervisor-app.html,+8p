/* the single most useful next action, pinned to the bottom */
/* the blocked block on the detail screen */
function nextAction(r){
  if(isUnassigned(r))                 return ['assign',  'user',   'Assign Provider',   'btn-primary'];
  if(r.flags.indexOf('otpfail')>=0)   return ['otp',     'key',    'Fix the OTP',       'btn-primary'];
  if(r.flags.indexOf('disputed')>=0)  return ['dispute', 'flag',   'Review dispute',    'btn-danger'];
  if(r.flags.indexOf('noresponse')>=0)return ['reassign','refresh','Reassign',          'btn-primary'];
  if(r.flags.indexOf('rejected')>=0)  return ['assign',  'user',   'Assign Provider',   'btn-primary'];
  if(r.st==='hold')                   return ['hold',    'cal',    'Reschedule visit',  'btn-primary'];
  if(r.st==='cancelled')              return ['more',    'list',   'More actions',      'btn-line'];
  if(r.st==='completed')              return ['more',    'list',   'More actions',      'btn-line'];
  if(r.otpSt==='pending')             return ['otp',     'key',    'View / share OTP',  'btn-primary'];
  return ['complete','checkC','Mark completed','btn-primary'];
}

/* ---------- OTP block: big code, plain state, one action ---------- */
function otpBlock(r, bare){
  var W = bare ? ['', ''] : ['<div class="det-blk">', '</div>'];
  if(!r.otp){
    return W[0]+'<div class="otp-plain dead">'
      + '<div class="otp-code">'+[0,1,2,3,4,5].map(function(){ return '<i>·</i>'; }).join('')+'</div>'
      + '<div class="otp-state">'+ic('info',14)+'Created automatically when you assign a provider</div>'
      + '</div>'
      + (isUnassigned(r) ? '' : '<button class="btn btn-wash btn-sm" style="margin-top:14px" data-otp="'+r.id+'">'
          + ic('key',17)+'Generate OTP now</button>')
      + W[1];
  }
  var cls = r.otpSt==='verified' ? 'ok' : (r.otpSt==='expired' ? 'dead' : '');
  var state = {
    pending :['warn','clock',  'Waiting to be verified · valid '+(r.otpExp||15)+' more min'],
    verified:['ok',  'checkC', 'Verified at '+r.otpAt],
    expired :['',    'alertC', 'Expired — generate a new code for the next visit'],
    failed  :['bad', 'alert',  (r.otpTries||0)+' of 3 attempts used · 1 left before lockout']
  }[r.otpSt] || ['','info',''];
  var act = r.otpSt==='verified' ? ''
    : '<button class="btn '+(r.otpSt==='failed'?'btn-primary':'btn-wash')+' btn-sm" style="margin-top:14px" data-otp="'+r.id+'">'
      + ic(r.otpSt==='expired'?'refresh':'send',17)
      + (r.otpSt==='expired' ? 'Generate a new OTP' : (r.otpSt==='failed' ? 'Resend or verify manually' : 'Resend / share code'))+'</button>';
  return W[0]+'<div class="otp-plain '+cls+'">'
    + '<div class="otp-code">'+String(r.otp).split('').map(function(d){ return '<i>'+d+'</i>'; }).join('')+'</div>'
    + '<div class="otp-state '+state[0]+'">'+ic(state[1],14)+state[2]+'</div>'
    + '<div class="otp-apps">'+ic('checkC',12)+'Same code in the <b>Resident</b> and <b>Handyman</b> apps</div>'
    + '</div>'+act+W[1];
}

/* ---- the resident's banner tone for a supervisor status ------------------ */
function bannerTone(r){
  if(r.st==='completed') return 'done';
  if(r.st==='cancelled') return 'cx';
  if(isUnassigned(r))    return 'wait';
  return 'prog';
}
/* Progress, as the resident sees it: a vertical list of named stages, each
   carrying the time it happened, the current one ringed, the rest greyed.
   Replaces the horizontal stepper — same stages, but the resident's shape,
   and it has room for the timestamps a supervisor actually needs. */
const DSTEPS = [
  ['new',      'Raised',       function(r){ return r.raised; }],
  ['assigned', 'Assigned',     function(r){ return r.assignedAt; }],
  ['onway',    'On the way',   function(r){ return r.onwayAt; }],
  ['arrived',  'Arrived',      function(r){ return r.arrivedAt; }],
  ['verified', 'OTP verified', function(r){ return r.otpAt; }],
  ['started',  'Work started', function(r){ return r.startedAt; }],
  ['completed','Completed',    function(r){ return r.doneAt; }]
];
function dTlStep(label, time, cls){
  var inner = cls==='done' ? ic('check',13)
            : cls==='cur'  ? '<span style="width:8px;height:8px;border-radius:50%;background:#fff;display:block"></span>'
            : '';
  return '<div class="tl-step '+cls+'"><span class="tl-mk">'+inner+'</span>'
       + '<div class="tl-tx"><b>'+esc(label)+'</b><span>'+esc(time)+'</span></div></div>';
}
function dTimeline(r){
  if(r.st==='cancelled'){
    var out = '';
    DSTEPS.forEach(function(st){ var t = st[2](r); if(t) out += dTlStep(st[1], t, 'done'); });
    return out + dTlStep('Cancelled', r.cancelAt || 'Just now', 'cx');
  }
  var cur = STATUS[r.st].step;
  return DSTEPS.map(function(st, i){
    var cls = r.st==='completed' ? 'done' : (i < cur ? 'done' : i === cur ? 'cur' : 'pend');
    var t   = st[2](r) || (cls==='cur' ? 'In progress now' : cls==='pend' ? 'Pending' : 'Done');
    return dTlStep(st[1], t, cls);
  }).join('');
}

